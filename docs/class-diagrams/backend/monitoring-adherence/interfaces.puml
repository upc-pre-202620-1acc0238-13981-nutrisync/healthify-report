@startuml Healthify - Monitoring and Adherence - Interfaces

skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam linetype ortho
hide empty members

package "Healthify.Platform.MonitoringAdherence.Interfaces" {

  package "Acl" {
    ' Read only. Every method degrades gracefully, because the monitoring panel
    ' is assembled from six contexts and one of them being quiet is not a
    ' reason for the other five to disappear.
    interface IMonitoringContextFacade {
      +GetDailyComplianceSeries(patientId: int, days: int, ct): Task<IReadOnlyList<DailyComplianceItem>>
      +GetConsistencyState(patientId: int, ct): Task<ConsistencyStateItem?>
      +GetAnthropometrySeries(patientId: int, ct): Task<IReadOnlyList<DailyComplianceItem>>
      +GetAnthropometrySeriesPoints(patientId: int, ct): Task<IReadOnlyList<AnthropometryPointItem>>
      +GetReferrals(patientId: int, ct): Task<IReadOnlyList<ReferralItem>>
    }
    ' The domain value the event storming names is exactly this pair, and it is
    ' all the ACL contract of this context ever publishes about a day.
    class DailyComplianceItem <<record>> {
      -Date: DateOnly
      -Outcome: string
    }
    class ConsistencyStateItem <<record>> {
      -State: string
      -ShownToPatientAt: DateTimeOffset?
      -EscalatedAt: DateTimeOffset?
    }
    ' Clinical readings only. Nothing merges the patient's own weigh-ins here.
    class AnthropometryPointItem <<record>> {
      -Date: DateOnly
      -ValueKg: decimal
      -Source: string
    }
    class ReferralItem <<record>> {
      -ReferralId: int
      -Specialty: string
      -Reason: string
      -IssuedBy: int
      -IssuedAt: DateTimeOffset
    }
  }

  package "REST" {
    ' Read only, and split by role: the daily indicator and the consistency
    ' card are the patient's, the deviations are the practitioner's. There is
    ' no endpoint that evaluates, detects, escalates or closes anything.
    class PatientMonitoringController {
      +GetEvaluationWindows(patientId: int): Task<IActionResult>
      +GetCurrentEvaluationWindow(patientId: int): Task<IActionResult>
      +GetDailyCompliance(patientId: int, date: DateOnly?): Task<IActionResult>
      +GetDeviations(patientId: int): Task<IActionResult>
      +GetConsistencyIndex(patientId: int): Task<IActionResult>
      +GetReferrals(patientId: int): Task<IActionResult>
    }
    ' One of the two commands in this context a person issues.
    class ReferralsController {
      +RecordReferral(resource: RecordReferralResource): Task<IActionResult>
    }
    ' The other one, plus the practitioner agenda.
    class ScheduledFollowUpsController {
      +ScheduleFollowUp(resource: ScheduleFollowUpResource): Task<IActionResult>
      +GetPractitionerAgenda(practitionerId: int): Task<IActionResult>
    }
  }

  package "REST.Resources" {
    class RecordReferralResource <<record>>
    class ScheduleFollowUpResource <<record>>
    class DailyComplianceResource <<record>>
    class TargetsSnapshotResource <<record>>
    class AnthropometryPointResource <<record>>
    class IntakeSummaryResource <<record>>
    class EvaluationWindowResource <<record>>
    class DeviationResource <<record>>
    class ConsistencyIndexResource <<record>>
    class ReferralResource <<record>>
    class ScheduledFollowUpResource <<record>>
  }

  package "REST.Transform" {
    class RecordReferralCommandAssembler <<static>>
    class ScheduleFollowUpCommandAssembler <<static>>
    class DailyComplianceResourceAssembler <<static>>
    class TargetsSnapshotResourceAssembler <<static>>
    class AnthropometryPointResourceAssembler <<static>>
    class EvaluationWindowResourceAssembler <<static>>
    class DeviationResourceAssembler <<static>>
    class ConsistencyIndexResourceAssembler <<static>>
    class ReferralResourceAssembler <<static>>
    class ScheduledFollowUpResourceAssembler <<static>>
    ' The single place where a MonitoringError becomes an HTTP status.
    class MonitoringActionResultAssembler <<static>>
  }
}

package "MonitoringAdherence.Application" <<external>> {
  interface IEvaluationWindowQueryService
  interface IDeviationQueryService
  interface IConsistencyIndexQueryService
  interface IReferralQueryService
  interface IReferralCommandService
  interface IScheduledFollowUpQueryService
  interface IScheduledFollowUpCommandService
}

package "MonitoringAdherence.Domain" <<external>> {
  class EvaluationWindow
  class Deviation
  class ConsistencyIndex
  class Referral
  class ScheduledFollowUp
  class DailyCompliance
  class TargetsSnapshot
  class AnthropometryPoint
  class IntakeSummary
  class RecordReferralCommand
  class ScheduleFollowUpCommand
  class GetEvaluationWindowsByPatientIdQuery
  class GetCurrentEvaluationWindowByPatientIdQuery
  class GetDailyComplianceByPatientIdQuery
  class GetDeviationsByPatientIdQuery
  class GetConsistencyIndexByPatientIdQuery
  class GetReferralsByPatientIdQuery
  class GetScheduledFollowUpsByPractitionerIdQuery
  enum MonitoringError
}

package "Shared / ASP.NET" <<external>> {
  class ControllerBase
  class "Result<TValue, TError>" as Result
  class ProblemDetailsFactory
  class ControllerBaseExtensions <<static>>
  interface "IStringLocalizer<T>" as IStringLocalizerGeneric
}

package "MonitoringAdherence.Resources" {
  class MonitoringMessages
}

' Resolved generic: the controllers depend on IStringLocalizer<MonitoringMessages>.
interface "IStringLocalizer<MonitoringMessages>" as IStringLocalizer
IStringLocalizer ..|> IStringLocalizerGeneric
IStringLocalizer ..> MonitoringMessages : parameterized by

' --- Controllers ---
PatientMonitoringController --|> ControllerBase
ReferralsController --|> ControllerBase
ScheduledFollowUpsController --|> ControllerBase
PatientMonitoringController --> IEvaluationWindowQueryService : uses
PatientMonitoringController --> IDeviationQueryService : uses
PatientMonitoringController --> IConsistencyIndexQueryService : uses
PatientMonitoringController --> IReferralQueryService : uses
PatientMonitoringController --> IStringLocalizer : uses
ReferralsController --> IReferralCommandService : uses
ReferralsController --> IStringLocalizer : uses
ScheduledFollowUpsController --> IScheduledFollowUpCommandService : uses
ScheduledFollowUpsController --> IScheduledFollowUpQueryService : uses
ScheduledFollowUpsController --> IStringLocalizer : uses

' --- The identity that is trusted is the one in the token ---
PatientMonitoringController ..> ControllerBaseExtensions : authorizes the reader
ReferralsController ..> ControllerBaseExtensions : reads practitioner id
ScheduledFollowUpsController ..> ControllerBaseExtensions : reads practitioner id

' --- Controllers to assemblers and queries ---
PatientMonitoringController ..> GetEvaluationWindowsByPatientIdQuery : builds
PatientMonitoringController ..> GetCurrentEvaluationWindowByPatientIdQuery : builds
PatientMonitoringController ..> GetDailyComplianceByPatientIdQuery : builds
PatientMonitoringController ..> GetDeviationsByPatientIdQuery : builds
PatientMonitoringController ..> GetConsistencyIndexByPatientIdQuery : builds
PatientMonitoringController ..> GetReferralsByPatientIdQuery : builds
PatientMonitoringController ..> EvaluationWindowResourceAssembler : uses
PatientMonitoringController ..> DailyComplianceResourceAssembler : uses
PatientMonitoringController ..> DeviationResourceAssembler : uses
PatientMonitoringController ..> ConsistencyIndexResourceAssembler : uses
PatientMonitoringController ..> ReferralResourceAssembler : uses
PatientMonitoringController ..> MonitoringActionResultAssembler : uses
ReferralsController ..> RecordReferralCommandAssembler : uses
ReferralsController ..> MonitoringActionResultAssembler : uses
ScheduledFollowUpsController ..> ScheduleFollowUpCommandAssembler : uses
ScheduledFollowUpsController ..> ScheduledFollowUpResourceAssembler : uses
ScheduledFollowUpsController ..> MonitoringActionResultAssembler : uses
ScheduledFollowUpsController ..> GetScheduledFollowUpsByPractitionerIdQuery : builds

' --- Request resource to command assemblers ---
RecordReferralCommandAssembler ..> RecordReferralResource : from
RecordReferralCommandAssembler ..> RecordReferralCommand : to
ScheduleFollowUpCommandAssembler ..> ScheduleFollowUpResource : from
ScheduleFollowUpCommandAssembler ..> ScheduleFollowUpCommand : to

' --- Entity to response resource assemblers ---
EvaluationWindowResourceAssembler ..> EvaluationWindow : from
EvaluationWindowResourceAssembler ..> EvaluationWindowResource : to
EvaluationWindowResourceAssembler ..> DailyComplianceResourceAssembler : uses
EvaluationWindowResourceAssembler ..> TargetsSnapshotResourceAssembler : uses
EvaluationWindowResourceAssembler ..> AnthropometryPointResourceAssembler : uses
EvaluationWindowResourceAssembler ..> IntakeSummary : from
EvaluationWindowResourceAssembler ..> IntakeSummaryResource : to
DailyComplianceResourceAssembler ..> DailyCompliance : from
DailyComplianceResourceAssembler ..> DailyComplianceResource : to
TargetsSnapshotResourceAssembler ..> TargetsSnapshot : from
TargetsSnapshotResourceAssembler ..> TargetsSnapshotResource : to
AnthropometryPointResourceAssembler ..> AnthropometryPoint : from
AnthropometryPointResourceAssembler ..> AnthropometryPointResource : to
DeviationResourceAssembler ..> Deviation : from
DeviationResourceAssembler ..> DeviationResource : to
ConsistencyIndexResourceAssembler ..> ConsistencyIndex : from
ConsistencyIndexResourceAssembler ..> ConsistencyIndexResource : to
ReferralResourceAssembler ..> Referral : from
ReferralResourceAssembler ..> ReferralResource : to
ScheduledFollowUpResourceAssembler ..> ScheduledFollowUp : from
ScheduledFollowUpResourceAssembler ..> ScheduledFollowUpResource : to

' --- Read resource composition ---
EvaluationWindowResource *--> "1" IntakeSummaryResource : contains
EvaluationWindowResource o--> "0..*" TargetsSnapshotResource : prescribed series
EvaluationWindowResource o--> "0..*" DailyComplianceResource : day-by-day series
EvaluationWindowResource o--> "0..*" AnthropometryPointResource : clinical weight series

' --- Result to IActionResult assembler ---
MonitoringActionResultAssembler ..> Result : maps
MonitoringActionResultAssembler ..> MonitoringError : maps
MonitoringActionResultAssembler ..> ReferralResourceAssembler : uses
MonitoringActionResultAssembler ..> ScheduledFollowUpResourceAssembler : uses
MonitoringActionResultAssembler ..> ProblemDetailsFactory : builds problem details with
MonitoringActionResultAssembler ..> IStringLocalizer : localizes with

' --- ACL facade contract & its DTOs ---
IMonitoringContextFacade ..> DailyComplianceItem : returns
IMonitoringContextFacade ..> ConsistencyStateItem : returns
IMonitoringContextFacade ..> AnthropometryPointItem : returns
IMonitoringContextFacade ..> ReferralItem : returns

@enduml
