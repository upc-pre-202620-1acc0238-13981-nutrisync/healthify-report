  class "Model.Events (5)" as Model_Events <<messages>> {
    ConsistencyPromptAcknowledged
    FollowUpCancelled
    FollowUpRescheduled
    PreVisitCheckInSubmitted
    ReferralClosed
  }
  class "Model.Queries (9)" as Model_Queries <<messages>> {
    GetDailyComplianceRangeQuery
    GetFollowUpsByPatientIdQuery
    GetLatestPreVisitCheckInQuery
    GetLatestWeeklySummaryByPatientIdQuery
    GetNextFollowUpByPatientIdQuery
    GetPractitionerAgendaQuery
    GetPreVisitCheckInByFollowUpIdQuery
    GetScheduledFollowUpByIdQuery
    GetScheduledFollowUpsByPatientIdsQuery
