@startuml Healthify - Monitoring and Adherence - Domain (part 1 of 4)

skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam nodesep 10
skinparam ranksep 14
hide empty members

title Monitoring and Adherence - Domain layer (part 1 of 4)

package "Healthify.Platform.MonitoringAdherence.Domain" {

  class "Model.Commands (14)" as Model_Commands <<messages>> {
    AcknowledgeConsistencyPromptCommand
    CancelFollowUpCommand
    CancelFollowUpsForPatientCommand
    CloseReferralCommand
    CompleteFollowUpFromConsultationCommand
    GenerateWeeklySummaryCommand
    MarkUnloggedDaysBeforeCommand
