  class AppendAnthropometryPointCommand
  class EvaluateDayCommand
  class ReEvaluateWindowCommand
  class DetectDeviationCommand
  class FlagSustainedDeviationCommand
  class RecomputeConsistencyIndexCommand
  class PromptPatientCommand
  class EscalateToPractitionerCommand
  class FlagLoggingGapCommand
  class RemindPatientCommand
  class CloseEvaluationWindowCommand
  class RecordReferralCommand
  class ScheduleFollowUpCommand
  class FlagMissedFollowUpCommand
  class GetEvaluationWindowsByPatientIdQuery
  class GetCurrentEvaluationWindowByPatientIdQuery
  class GetDailyComplianceByPatientIdQuery
  class GetOpenEvaluationWindowsQuery
  class GetDeviationsByPatientIdQuery
  class GetConsistencyIndexByPatientIdQuery
  class GetEscalatableConsistencyIndicesQuery
  class GetReferralsByPatientIdQuery
  class GetScheduledFollowUpsByPractitionerIdQuery
  class GetOverdueScheduledFollowUpsQuery
  class EvaluationWindowOpened
  class TargetsSnapshotTaken
  class AnthropometryPointAppended
  class DayEvaluated
  class DailyComplianceComputed
  class WindowReEvaluated
  class DeviationDetected
  class SustainedDeviationDetected
