@startuml Healthify - Monitoring and Adherence - Application

skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam linetype ortho
hide empty members

package "Healthify.Platform.MonitoringAdherence.Application" {

  package "CommandServices" {
    ' Subflows 5.1 to 5.5, 5.9 and 5.11. Every one is driven by a policy: none
    ' of these commands has an endpoint.
    interface IEvaluationWindowCommandService {
      +Handle(command: OpenEvaluationWindowCommand, ct): Task<Result<EvaluationWindow, MonitoringError>>
      +Handle(command: SnapshotActiveTargetsCommand, ct): Task<Result<EvaluationWindow, MonitoringError>>
      +Handle(command: AppendAnthropometryPointCommand, ct): Task<Result<EvaluationWindow, MonitoringError>>
      +Handle(command: EvaluateDayCommand, ct): Task<Result<EvaluationWindow, MonitoringError>>
      +Handle(command: ReEvaluateWindowCommand, ct): Task<Result<EvaluationWindow, MonitoringError>>
      +Handle(command: FlagLoggingGapCommand, ct): Task<Result<EvaluationWindow, MonitoringError>>
      +Handle(command: RemindPatientCommand, ct): Task<Result<EvaluationWindow, MonitoringError>>
      +Handle(command: CloseEvaluationWindowCommand, ct): Task<Result<EvaluationWindow, MonitoringError>>
    }
    interface IDeviationCommandService {
      +Handle(command: DetectDeviationCommand, ct): Task<Result<Deviation, MonitoringError>>
      +Handle(command: FlagSustainedDeviationCommand, ct): Task<Result<Deviation, MonitoringError>>
    }
    interface IConsistencyIndexCommandService {
      +Handle(command: RecomputeConsistencyIndexCommand, ct): Task<Result<ConsistencyIndex, MonitoringError>>
      +Handle(command: PromptPatientCommand, ct): Task<Result<ConsistencyIndex, MonitoringError>>
      +Handle(command: EscalateToPractitionerCommand, ct): Task<Result<ConsistencyIndex, MonitoringError>>
    }
    interface IReferralCommandService {
      +Handle(command: RecordReferralCommand, ct): Task<Result<Referral, MonitoringError>>
    }
    interface IScheduledFollowUpCommandService {
      +Handle(command: ScheduleFollowUpCommand, ct): Task<Result<ScheduledFollowUp, MonitoringError>>
      +Handle(command: FlagMissedFollowUpCommand, ct): Task<Result<ScheduledFollowUp, MonitoringError>>
    }
  }

  package "QueryServices" {
    interface IEvaluationWindowQueryService {
      +Handle(query: GetEvaluationWindowsByPatientIdQuery, ct): Task<IEnumerable<EvaluationWindow>>
      +Handle(query: GetCurrentEvaluationWindowByPatientIdQuery, ct): Task<EvaluationWindow?>
      +Handle(query: GetDailyComplianceByPatientIdQuery, ct): Task<IReadOnlyList<DailyCompliance>>
      +Handle(query: GetOpenEvaluationWindowsQuery, ct): Task<IEnumerable<EvaluationWindow>>
    }
    interface IDeviationQueryService {
      +Handle(query: GetDeviationsByPatientIdQuery, ct): Task<IEnumerable<Deviation>>
    }
    interface IConsistencyIndexQueryService {
      +Handle(query: GetConsistencyIndexByPatientIdQuery, ct): Task<ConsistencyIndex?>
      +Handle(query: GetEscalatableConsistencyIndicesQuery, ct): Task<IEnumerable<ConsistencyIndex>>
    }
    interface IReferralQueryService {
      +Handle(query: GetReferralsByPatientIdQuery, ct): Task<IEnumerable<Referral>>
    }
    interface IScheduledFollowUpQueryService {
      +Handle(query: GetScheduledFollowUpsByPractitionerIdQuery, ct): Task<IEnumerable<ScheduledFollowUp>>
      +Handle(query: GetOverdueScheduledFollowUpsQuery, ct): Task<IEnumerable<ScheduledFollowUp>>
    }
  }

  package "Internal" {
    package "Internal.CommandServices" {
      ' The only class in the platform that sets what was prescribed beside
      ' what was recorded. It reads the recorded side through the published
      ' contract of the context that owns it; neither side is written here.
      class EvaluationWindowCommandService {
        +Handle(command: OpenEvaluationWindowCommand, ct): Task<Result<...>>
        +Handle(command: SnapshotActiveTargetsCommand, ct): Task<Result<...>>
        +Handle(command: AppendAnthropometryPointCommand, ct): Task<Result<...>>
        +Handle(command: EvaluateDayCommand, ct): Task<Result<...>>
        +Handle(command: ReEvaluateWindowCommand, ct): Task<Result<...>>
        +Handle(command: FlagLoggingGapCommand, ct): Task<Result<...>>
        +Handle(command: RemindPatientCommand, ct): Task<Result<...>>
        +Handle(command: CloseEvaluationWindowCommand, ct): Task<Result<...>>
        -EvaluateSingleDay(patientId, date, isReEvaluation, ct): Task<Result<...>>
        -ConfiguredWindowDays(): int
      }
      class DeviationCommandService {
        +Handle(command: DetectDeviationCommand, ct): Task<Result<...>>
        +Handle(command: FlagSustainedDeviationCommand, ct): Task<Result<...>>
        -PublishDetected(deviation: Deviation, ct): Task
      }
      ' TODO UNCALIBRATED: Monitoring:ConsistencyAlertThreshold ships at 1.5
      ' kg/week, derived rather than validated. At zero the key reads as unset:
      ' the index is computed and shown, and nothing escalates.
      class ConsistencyIndexCommandService {
        -{static} TrendDays: int = 90
        +Handle(command: RecomputeConsistencyIndexCommand, ct): Task<Result<...>>
        +Handle(command: PromptPatientCommand, ct): Task<Result<...>>
        +Handle(command: EscalateToPractitionerCommand, ct): Task<Result<...>>
        -ConfiguredThreshold(): decimal
      }
      class ReferralCommandService {
        +Handle(command: RecordReferralCommand, ct): Task<Result<...>>
      }
      ' It injects nothing that could revoke a link or discharge a patient.
      class ScheduledFollowUpCommandService {
        +Handle(command: ScheduleFollowUpCommand, ct): Task<Result<...>>
        +Handle(command: FlagMissedFollowUpCommand, ct): Task<Result<...>>
      }
    }

    package "Internal.QueryServices" {
      class EvaluationWindowQueryService
      class DeviationQueryService
      class ConsistencyIndexQueryService
      class ReferralQueryService
      class ScheduledFollowUpQueryService
    }

    package "Internal.EventHandlers" {
      ' Integration event 1 of 13. Interpretation starts when the relationship
      ' does.
      class OnCareLinkEstablishedHandler {
        +Handle(notification: CareLinkEstablished, ct): Task
      }
      ' Integration event 5 of 13: the one that freezes the contract.
      class OnActiveTargetsUpdatedMonitoringHandler {
        +Handle(notification: ActiveTargetsUpdated, ct): Task
      }
      ' Integration event 3 of 13.
      class OnClinicalMeasurementTakenHandler {
        +Handle(notification: ClinicalMeasurementTaken, ct): Task
      }
      ' Integration events 7, 8 and 9 of 13. Three separate policies in the
      ' model, so three separate handlers.
      class OnMealLoggedHandler {
        +Handle(notification: MealLogged, ct): Task
      }
      class OnEstimateConfirmedByPatientHandler {
        +Handle(notification: EstimateConfirmedByPatient, ct): Task
      }
      class OnOffPlanEntryLoggedHandler {
        +Handle(notification: OffPlanEntryLogged, ct): Task
      }
      ' Integration event 11 of 13. Re-evaluates one day, and only that day.
      class OnEntrySynchronizedHandler {
        +Handle(notification: EntrySynchronized, ct): Task
      }
      class OnDayEvaluatedHandler {
        +Handle(notification: DayEvaluated, ct): Task
      }
      ' The gate between an observation and a signal.
      class OnDeviationDetectedHandler {
        +Handle(notification: DeviationDetected, ct): Task
      }
      ' Integration event 10 of 13.
      class OnWeightTrendRecalculatedHandler {
        +Handle(notification: WeightTrendRecalculated, ct): Task
      }
      ' The only handler of the alert: no path by which a practitioner learns
      ' about one the patient has not been asked about first.
      class OnConsistencyAlertRaisedHandler {
        +Handle(notification: ConsistencyAlertRaised, ct): Task
      }
      ' The only handler of a logging gap in the whole platform, and all it
      ' does is remind the patient.
      class OnLoggingGapDetectedHandler {
        +Handle(notification: LoggingGapDetected, ct): Task
      }
      ' Integration event 2 of 13.
      class OnCareLinkRevokedHandler {
        +Handle(notification: CareLinkRevoked, ct): Task
      }
      ' The body the three Subflow 5.4 policies share.
      class MonitoringDayEvaluation <<static>> {
        +{static} Evaluate(scopeFactory, logger, patientId, localTimestamp, ct): Task
      }
    }
  }

  package "Acl" {
    ' A composite read model that asks a question this context cannot answer
    ' gets an empty section rather than a failed page.
    class MonitoringContextFacade {
      +GetDailyComplianceSeries(patientId: int, days: int, ct): Task<IReadOnlyList<DailyComplianceItem>>
      +GetConsistencyState(patientId: int, ct): Task<ConsistencyStateItem?>
      +GetAnthropometrySeries(patientId: int, ct): Task<IReadOnlyList<DailyComplianceItem>>
      +GetAnthropometrySeriesPoints(patientId: int, ct): Task<IReadOnlyList<AnthropometryPointItem>>
      +GetReferrals(patientId: int, ct): Task<IReadOnlyList<ReferralItem>>
    }
  }
}

