  interface IConsistencyIndexRepository
  interface IReferralRepository
  interface IScheduledFollowUpRepository
  enum MonitoringError
}

package "MonitoringAdherence.Interfaces.Acl" <<external>> {
  interface IMonitoringContextFacade
  class DailyComplianceItem <<record>>
  class ConsistencyStateItem <<record>>
  class AnthropometryPointItem <<record>>
  class ReferralItem <<record>>
}

package "Events owned by other contexts" <<external>> {
  class CareLinkEstablished
  class CareLinkRevoked
  class ActiveTargetsUpdated
  class ClinicalMeasurementTaken
  class MealLogged
  class EstimateConfirmedByPatient
  class OffPlanEntryLogged
  class EntrySynchronized
  class WeightTrendRecalculated
}

package "Other contexts' ACL" <<external>> {
  interface ICareRelationshipContextFacade
  interface IIntakeContextFacade
}

package "Shared / Cortex" <<external>> {
  class "Result<TValue, TError>" as Result
  interface IUnitOfWork
  interface IMediator
  interface "IEventHandler<T>" as IEventHandler
  interface IServiceScopeFactory
  interface IConfiguration
  interface "ILogger<T>" as ILogger
}

' --- Service interface realizations ---
EvaluationWindowCommandService ..|> IEvaluationWindowCommandService
DeviationCommandService ..|> IDeviationCommandService
ConsistencyIndexCommandService ..|> IConsistencyIndexCommandService
ReferralCommandService ..|> IReferralCommandService
ScheduledFollowUpCommandService ..|> IScheduledFollowUpCommandService
EvaluationWindowQueryService ..|> IEvaluationWindowQueryService
DeviationQueryService ..|> IDeviationQueryService
ConsistencyIndexQueryService ..|> IConsistencyIndexQueryService
ReferralQueryService ..|> IReferralQueryService
ScheduledFollowUpQueryService ..|> IScheduledFollowUpQueryService
MonitoringContextFacade ..|> IMonitoringContextFacade
OnCareLinkEstablishedHandler ..|> IEventHandler
OnActiveTargetsUpdatedMonitoringHandler ..|> IEventHandler
OnClinicalMeasurementTakenHandler ..|> IEventHandler
OnMealLoggedHandler ..|> IEventHandler
OnEstimateConfirmedByPatientHandler ..|> IEventHandler
OnOffPlanEntryLoggedHandler ..|> IEventHandler
OnEntrySynchronizedHandler ..|> IEventHandler
OnDayEvaluatedHandler ..|> IEventHandler
OnDeviationDetectedHandler ..|> IEventHandler
OnWeightTrendRecalculatedHandler ..|> IEventHandler
OnConsistencyAlertRaisedHandler ..|> IEventHandler
OnLoggingGapDetectedHandler ..|> IEventHandler
OnCareLinkRevokedHandler ..|> IEventHandler

' --- EvaluationWindowCommandService (Subflows 5.1 to 5.5, 5.9, 5.11) ---
EvaluationWindowCommandService --> IEvaluationWindowRepository : uses
EvaluationWindowCommandService --> IIntakeContextFacade : reads the recorded side through
EvaluationWindowCommandService --> IUnitOfWork : commits with
EvaluationWindowCommandService --> IConfiguration : reads window and gap settings from
EvaluationWindowCommandService --> IMediator : publishes via
EvaluationWindowCommandService --> ILogger : logs to
EvaluationWindowCommandService ..> OpenEvaluationWindowCommand : handles
EvaluationWindowCommandService ..> SnapshotActiveTargetsCommand : handles
EvaluationWindowCommandService ..> AppendAnthropometryPointCommand : handles
EvaluationWindowCommandService ..> EvaluateDayCommand : handles
EvaluationWindowCommandService ..> ReEvaluateWindowCommand : handles
EvaluationWindowCommandService ..> FlagLoggingGapCommand : handles
EvaluationWindowCommandService ..> RemindPatientCommand : handles
EvaluationWindowCommandService ..> CloseEvaluationWindowCommand : handles
EvaluationWindowCommandService ..> EvaluationWindow : creates / mutates
EvaluationWindowCommandService ..> TargetsSnapshot : appends
EvaluationWindowCommandService ..> AnthropometryPoint : appends
EvaluationWindowCommandService ..> DailyCompliance : evaluates
EvaluationWindowCommandService ..> EvaluationWindowOpened : publishes
EvaluationWindowCommandService ..> TargetsSnapshotTaken : publishes
EvaluationWindowCommandService ..> AnthropometryPointAppended : publishes
EvaluationWindowCommandService ..> DayEvaluated : publishes
EvaluationWindowCommandService ..> DailyComplianceComputed : publishes
EvaluationWindowCommandService ..> WindowReEvaluated : publishes
EvaluationWindowCommandService ..> LoggingGapDetected : publishes
EvaluationWindowCommandService ..> PatientReminded : publishes
EvaluationWindowCommandService ..> EvaluationWindowClosed : publishes
EvaluationWindowCommandService ..> MonitoringError : returns

' --- DeviationCommandService (Subflow 5.6) ---
DeviationCommandService --> IDeviationRepository : uses
DeviationCommandService --> IEvaluationWindowRepository : reads the horizon from
DeviationCommandService --> IUnitOfWork : commits with
DeviationCommandService --> IConfiguration : reads the sustained ratio from
DeviationCommandService --> IMediator : publishes via
DeviationCommandService --> ILogger : logs to
DeviationCommandService ..> DetectDeviationCommand : handles
DeviationCommandService ..> FlagSustainedDeviationCommand : handles
DeviationCommandService ..> Deviation : detects / restates
DeviationCommandService ..> DeviationDirection : deduplicates per direction
DeviationCommandService ..> DeviationMagnitude : measures
DeviationCommandService ..> DeviationDetected : publishes
DeviationCommandService ..> SustainedDeviationDetected : publishes once
DeviationCommandService ..> MonitoringError : returns

' --- ConsistencyIndexCommandService (Subflows 5.7 and 5.8) ---
ConsistencyIndexCommandService --> IConsistencyIndexRepository : uses
ConsistencyIndexCommandService --> IEvaluationWindowRepository : reads the intake series from
ConsistencyIndexCommandService --> IIntakeContextFacade : reads the weight trend through
ConsistencyIndexCommandService --> ICareRelationshipContextFacade : resolves the practitioner with
ConsistencyIndexCommandService --> IUnitOfWork : commits with
ConsistencyIndexCommandService --> IConfiguration : reads the threshold and the weeks from
ConsistencyIndexCommandService --> IMediator : publishes via
ConsistencyIndexCommandService --> ILogger : logs to
ConsistencyIndexCommandService ..> RecomputeConsistencyIndexCommand : handles
ConsistencyIndexCommandService ..> PromptPatientCommand : handles
ConsistencyIndexCommandService ..> EscalateToPractitionerCommand : handles
ConsistencyIndexCommandService ..> ConsistencyIndex : creates / recomputes
ConsistencyIndexCommandService ..> DailyCompliance : one of the two series
ConsistencyIndexCommandService ..> ConsistencyIndexRecomputed : publishes
ConsistencyIndexCommandService ..> ConsistencyAlertRaised : publishes
ConsistencyIndexCommandService ..> PatientPromptedAboutConsistency : publishes
ConsistencyIndexCommandService ..> AlertEscalatedToPractitioner : publishes
ConsistencyIndexCommandService ..> MonitoringError : returns

' --- ReferralCommandService and ScheduledFollowUpCommandService (5.10) ---
ReferralCommandService --> IReferralRepository : uses
ReferralCommandService --> ICareRelationshipContextFacade : requires a live link
ReferralCommandService --> IUnitOfWork : commits with
ReferralCommandService --> IMediator : publishes via
ReferralCommandService --> ILogger : logs to
ReferralCommandService ..> RecordReferralCommand : handles
ReferralCommandService ..> Referral : creates
ReferralCommandService ..> ReferralRecorded : publishes
ReferralCommandService ..> MonitoringError : returns
ScheduledFollowUpCommandService --> IScheduledFollowUpRepository : uses
ScheduledFollowUpCommandService --> ICareRelationshipContextFacade : requires a live link
ScheduledFollowUpCommandService --> IUnitOfWork : commits with
ScheduledFollowUpCommandService --> IMediator : publishes via
ScheduledFollowUpCommandService --> ILogger : logs to
ScheduledFollowUpCommandService ..> ScheduleFollowUpCommand : handles
ScheduledFollowUpCommandService ..> FlagMissedFollowUpCommand : handles
ScheduledFollowUpCommandService ..> ScheduledFollowUp : creates / flags
ScheduledFollowUpCommandService ..> FollowUpScheduled : publishes
ScheduledFollowUpCommandService ..> FollowUpMissed : publishes
ScheduledFollowUpCommandService ..> MonitoringError : returns

' --- Policies from other contexts ---
OnCareLinkEstablishedHandler ..> CareLinkEstablished : subscribes to
OnCareLinkEstablishedHandler --> IEvaluationWindowCommandService : delegates to
OnCareLinkEstablishedHandler ..> OpenEvaluationWindowCommand : issues
OnActiveTargetsUpdatedMonitoringHandler ..> ActiveTargetsUpdated : subscribes to
OnActiveTargetsUpdatedMonitoringHandler --> IEvaluationWindowCommandService : delegates to
OnActiveTargetsUpdatedMonitoringHandler ..> SnapshotActiveTargetsCommand : issues
OnClinicalMeasurementTakenHandler ..> ClinicalMeasurementTaken : subscribes to
OnClinicalMeasurementTakenHandler --> IEvaluationWindowCommandService : delegates to
OnClinicalMeasurementTakenHandler ..> AppendAnthropometryPointCommand : issues
OnMealLoggedHandler ..> MealLogged : subscribes to
OnMealLoggedHandler ..> MonitoringDayEvaluation : delegates to
OnEstimateConfirmedByPatientHandler ..> EstimateConfirmedByPatient : subscribes to
OnEstimateConfirmedByPatientHandler ..> MonitoringDayEvaluation : delegates to
OnOffPlanEntryLoggedHandler ..> OffPlanEntryLogged : subscribes to
OnOffPlanEntryLoggedHandler ..> MonitoringDayEvaluation : delegates to
