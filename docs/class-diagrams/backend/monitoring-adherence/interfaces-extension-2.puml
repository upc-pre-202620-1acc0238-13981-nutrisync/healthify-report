@startuml Healthify - Monitoring and Adherence - Interfaces (part 2 of 3)

skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam nodesep 10
skinparam ranksep 14
hide empty members

title Monitoring and Adherence - Interfaces layer (part 2 of 3)

package "Healthify.Platform.MonitoringAdherence.Interfaces" {

  package "Acl" {
    class CheckInQuestionItem <<record>> {
      -Text: string
      -Origin: string
      -Language: string?
    }
    class ComplianceRangeItem <<record>> {
      -Days: IReadOnlyList<DailyComplianceItem>
      -Summary: ComplianceSummaryItem
    }
    class ComplianceSummaryItem <<record>> {
      -Met: int
      -Exceeded: int
      -Short: int
      -Unlogged: int
      -Logged: int
      -TotalDays: int
    }
    class NextFollowUpItem <<record>> {
      -FollowUpId: int
      -PatientId: int
      -ScheduledFor: DateTimeOffset
      -Modality: string
      -Preparation: IReadOnlyList<string>
      -ScheduledAt: DateTimeOffset?
      -PractitionerId: int
    }
    class PreVisitCheckInItem <<record>> {
      -FollowUpId: int
      -Feeling: string
      -Difficulties: IReadOnlyList<string>
      -Questions: IReadOnlyList<CheckInQuestionItem>
      -SubmittedAt: DateTimeOffset
      -EditedAt: DateTimeOffset?
      -IsLocked: bool
    }
  }
  package "REST" {
    class ConsistencyPromptController
    class FollowUpCheckInController
    class PatientAiSummariesController
  }
}

CheckInQuestionItem -[hidden]down-> ConsistencyPromptController

@enduml
