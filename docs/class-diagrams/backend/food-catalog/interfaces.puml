@startuml Healthify - Food Catalog - Interfaces

skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam linetype ortho
hide empty members

package "Healthify.Platform.FoodCatalog.Interfaces" {

  package "Acl" {
    interface IFoodCatalogContextFacade {
      +GetReferenceFoodById(referenceFoodId: int, ct): Task<ReferenceFoodItem?>
      +SearchReferenceFoods(term: string, max: int, ct): Task<IReadOnlyList<ReferenceFoodItem>>
    }
    class ReferenceFoodItem <<record>> {
      -ReferenceFoodId: int
      -LocalName: string
      -EnergyKcalPer100g: decimal
      -ProteinGPer100g: decimal
      -CarbGPer100g: decimal
      -FatGPer100g: decimal
      -IsLocalOverride: bool
    }
  }

  package "REST" {
    class ReferenceFoodsController {
      +SearchReferenceFoods(query: string?, max: int): Task<IActionResult>
      +GetReferenceFoodById(referenceFoodId: int): Task<IActionResult>
      +CreateLocalOverride(resource: CreateLocalOverrideResource): Task<IActionResult>
      +ImportCatalogSnapshot(resource: ImportCatalogSnapshotResource): Task<IActionResult>
    }
    class LocalFoodCatalogController {
      -{static} MaxEntries: int = 500
      +GetLocalFoodCatalog(patientId: int): Task<IActionResult>
    }
  }

  package "REST.Resources" {
    class CreateLocalOverrideResource <<record>>
    class ImportCatalogSnapshotResource <<record>>
    class ReferenceFoodResource <<record>>
    class CatalogImportSummaryResource <<record>>
  }

  package "REST.Transform" {
    class CreateLocalOverrideCommandAssembler <<static>>
    class ImportCatalogSnapshotCommandAssembler <<static>>
    class ReferenceFoodResourceAssembler <<static>>
    class CatalogImportSummaryResourceAssembler <<static>>
    class FoodCatalogActionResultAssembler <<static>>
  }
}

package "FoodCatalog.Application" <<external>> {
  interface IReferenceFoodCommandService
  interface IReferenceFoodQueryService
  class CatalogImportSummary
}

package "FoodCatalog.Domain" <<external>> {
  class ReferenceFood
  class CreateLocalOverrideCommand
  class ImportCatalogSnapshotCommand
  class SearchFoodCommand
  class GetReferenceFoodByIdQuery
  class GetLocalFoodCatalogQuery
  enum FoodCatalogError
}

package "Shared / ASP.NET" <<external>> {
  class ControllerBase
  class "Result<TValue, TError>" as Result
  class ProblemDetailsFactory
  class ControllerBaseExtensions <<static>>
  interface "IStringLocalizer<T>" as IStringLocalizerGeneric
}

package "FoodCatalog.Resources" {
  class FoodCatalogMessages
}

interface "IStringLocalizer<FoodCatalogMessages>" as IStringLocalizer
IStringLocalizer ..|> IStringLocalizerGeneric
IStringLocalizer ..> FoodCatalogMessages : parameterized by

ReferenceFoodsController --|> ControllerBase
LocalFoodCatalogController --|> ControllerBase
ReferenceFoodsController --> IReferenceFoodCommandService : uses
ReferenceFoodsController --> IReferenceFoodQueryService : uses
ReferenceFoodsController --> IStringLocalizer : uses
LocalFoodCatalogController --> IReferenceFoodQueryService : uses
LocalFoodCatalogController ..> FoodCatalogMessages : shares localization resources

ReferenceFoodsController ..> ControllerBaseExtensions : reads practitioner id
LocalFoodCatalogController ..> ControllerBaseExtensions : authorizes the patient

ReferenceFoodsController ..> SearchFoodCommand : builds
ReferenceFoodsController ..> GetReferenceFoodByIdQuery : builds
ReferenceFoodsController ..> CreateLocalOverrideCommandAssembler : uses
ReferenceFoodsController ..> ImportCatalogSnapshotCommandAssembler : uses
ReferenceFoodsController ..> ReferenceFoodResourceAssembler : uses
ReferenceFoodsController ..> FoodCatalogActionResultAssembler : uses
LocalFoodCatalogController ..> GetLocalFoodCatalogQuery : builds
LocalFoodCatalogController ..> ReferenceFoodResourceAssembler : uses

CreateLocalOverrideCommandAssembler ..> CreateLocalOverrideResource : from
CreateLocalOverrideCommandAssembler ..> CreateLocalOverrideCommand : to
ImportCatalogSnapshotCommandAssembler ..> ImportCatalogSnapshotResource : from
ImportCatalogSnapshotCommandAssembler ..> ImportCatalogSnapshotCommand : to

ReferenceFoodResourceAssembler ..> ReferenceFood : from
ReferenceFoodResourceAssembler ..> ReferenceFoodResource : to
CatalogImportSummaryResourceAssembler ..> CatalogImportSummary : from
CatalogImportSummaryResourceAssembler ..> CatalogImportSummaryResource : to

FoodCatalogActionResultAssembler ..> Result : maps
FoodCatalogActionResultAssembler ..> FoodCatalogError : maps
FoodCatalogActionResultAssembler ..> ReferenceFoodResourceAssembler : uses
FoodCatalogActionResultAssembler ..> CatalogImportSummaryResourceAssembler : uses
FoodCatalogActionResultAssembler ..> ProblemDetailsFactory : builds problem details with
FoodCatalogActionResultAssembler ..> IStringLocalizer : localizes with

IFoodCatalogContextFacade ..> ReferenceFoodItem : returns

@enduml
