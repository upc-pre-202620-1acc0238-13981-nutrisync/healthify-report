@startuml Healthify - Food Catalog - Interfaces (part 1 of 1)

skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam nodesep 10
skinparam ranksep 14
hide empty members

title Food Catalog - Interfaces layer (part 1 of 1)

package "Healthify.Platform.FoodCatalog.Interfaces" {


  package "Acl" {
    class FoodNutrientsItem <<record>> {
      -EnergyKcalPer100g: decimal
      -ProteinGPer100g: decimal
      -CarbGPer100g: decimal
      -FatGPer100g: decimal
    }
    class ResolvedFoodItem <<record>> {
      -Name: string
      -ReferenceFoodId: int?
      -EnergyKcalPer100g: decimal?
      -ProteinGPer100g: decimal?
      -CarbGPer100g: decimal?
      -FatGPer100g: decimal?
      -LocalName: string?
      +IsResolved: bool
    }
  }
}


@enduml
