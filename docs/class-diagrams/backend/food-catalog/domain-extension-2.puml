package "Healthify.Platform.FoodCatalog.Domain" {

  package "Model.ValueObjects" {
    class FoodSource <<record>> {
      +Imported: string
      +LocalOverride: string
      +AiEstimated: string
      +MaxLength: int
      +FoodSource(value: string)
      +Value: string
      +IsAiEstimated: bool
      +ToString(): string
    }
  }
  package "Services" {
    class FoodNameMatcher {
      +SearchTermLength: int
      +{static} SearchTermOf(name: string): string?
      +{static} BestMatch(name: string, candidates: IEnumerable<ReferenceFood>): ReferenceFood?
      +MinimumSharedWords: int
      +MaximumExtraWords: int
