      +{static} AtwaterEnergy(proteinG: decimal, carbG: decimal, fatG: decimal): decimal
    }
    class NutrientTolerance <<record>> {
      -Percent: decimal
      -Kcal: decimal
      +DefaultPercent: decimal
      +DefaultKcal: decimal
      +{static} Default: NutrientTolerance
      +AllowedFor(energyKcal: decimal): decimal
    }
  }
}

