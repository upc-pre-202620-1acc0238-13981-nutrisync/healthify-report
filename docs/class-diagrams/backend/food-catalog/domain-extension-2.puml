      +{static} ClearSimilarMatch(name: string, candidates: IEnumerable<ReferenceFood>): ReferenceFood?
      +{static} Normalize(text: string?): string
    }
    class NutrientCoherence {
      +MaxEnergyKcal: decimal
      +MaxMacroGrams: decimal
      +{static} Violations(energyKcal: decimal, proteinG: decimal, carbG: decimal, fatG: decimal, tolerance: NutrientTolerance?): IReadOnlyList<string>
