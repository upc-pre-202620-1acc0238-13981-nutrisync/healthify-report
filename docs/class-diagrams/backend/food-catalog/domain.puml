@startuml Healthify - Food Catalog - Domain

skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam linetype ortho
hide empty members

package "Healthify.Platform.FoodCatalog.Domain" {

  package "Model.Aggregates" {
    ' ReferenceFood is a partial class: ReferenceFood.cs + ReferenceFoodAudit.cs.
    ' A Generic context, deliberately thin: everything interesting happens at
    ' its edge. Nothing from a provider reaches this class untranslated, and
    ' what the provider called the record survives only as an opaque digest.
    class ReferenceFood {
      -Id: ReferenceFoodId
      -LocalNameText: string
      -EnergyKcalPer100g: decimal
      -ProteinGPer100g: decimal
      -CarbGPer100g: decimal
      -FatGPer100g: decimal
      -SourceHash: SourceHash
      -IsLocalOverride: bool
      -CreatedAt: DateTimeOffset?
      -UpdatedAt: DateTimeOffset?
      +LocalName: LocalName <<derived>>
      +NutrientsPer100g: NutrientsPer100g <<derived>>
      #ReferenceFood()
      +ReferenceFood(localName: LocalName, nutrients: NutrientsPer100g, sourceHash: SourceHash)
      +ReferenceFood(command: CreateLocalOverrideCommand)
      +RefreshFromUpstream(localName: LocalName, nutrients: NutrientsPer100g): void
      -StoreNutrients(nutrients: NutrientsPer100g): void
    }
  }

  package "Model.ValueObjects" {
    class ReferenceFoodId <<record>> {
      -Value: int
      +ReferenceFoodId(value: int)
      +{static} FromRaw(value: int): ReferenceFoodId
    }
    ' The result of the translation, never the provider's own label.
    class LocalName <<record>> {
      +{static} MaxLength: int = 200
      -Value: string
      +LocalName(value: string)
      +ToString(): string
    }
    ' Per 100 g and never per portion: the portion is declared by whoever logs
    ' the meal, so one reference food serves every portion size.
    class NutrientsPer100g <<record>> {
      -{static} MaxEnergyKcal: decimal = 950
      -EnergyKcal: decimal
      -ProteinG: decimal
      -CarbG: decimal
      -FatG: decimal
      +NutrientsPer100g(energyKcal, proteinG, carbG, fatG)
    }
    ' A one-way digest rather than the provider identifier: an identifier would
    ' be an external concept living inside the domain. A digest cannot be.
    class SourceHash <<record>> {
      +{static} Length: int = 64
      -{static} PartSeparator: string = "::"
      -Value: string
      +SourceHash(value: string)
      +{static} Of(parts: string[]): SourceHash
      +{static} ForLocalOverride(localName: string): SourceHash
      +ToString(): string
    }
  }

  package "Model.Commands" {
    class ImportCatalogSnapshotCommand <<record>> {
      -Term: string
      -Max: int
    }
    ' Issued by the policy reacting to ReferenceFoodTranslated, never by an
    ' endpoint: nothing enters the catalog that has not been translated first.
    class CacheFoodLocallyCommand <<record>> {
      -LocalName: string
      -EnergyKcalPer100g: decimal
      -ProteinGPer100g: decimal
      -CarbGPer100g: decimal
      -FatGPer100g: decimal
      -SourceHash: string
    }
    class SearchFoodCommand <<record>> {
      -Term: string
      -Max: int
    }
    class CreateLocalOverrideCommand <<record>> {
      -PractitionerId: int
      -LocalName: string
      -EnergyKcalPer100g: decimal
      -ProteinGPer100g: decimal
      -CarbGPer100g: decimal
      -FatGPer100g: decimal
    }
  }

  package "Model.Queries" {
    class GetReferenceFoodByIdQuery <<record>> {
      -ReferenceFoodId: int
    }
    class SearchReferenceFoodsQuery <<record>> {
      -Term: string
      -Max: int
    }
    class GetLocalFoodCatalogQuery <<record>> {
      -Max: int
    }
  }

  package "Model.Events" {
    ' Every Food Catalog event stays inside Food Catalog: Intake reads the
    ' catalog synchronously through the ACL facade instead of subscribing.
    class ExternalCatalogSnapshotImported <<record>> {
      -ProviderName: string
      -Term: string
      -TranslatedCount: int
      -FailedCount: int
    }
    ' One upstream record crossed the anti-corruption layer. No external
    ' identifier in the payload, only the opaque digest.
    class ReferenceFoodTranslated <<record>> {
      -LocalName: string
      -EnergyKcalPer100g: decimal
      -ProteinGPer100g: decimal
      -CarbGPer100g: decimal
      -FatGPer100g: decimal
      -SourceHash: string
    }
    ' Negative branch: a record that could not be expressed in this vocabulary
    ' is dropped and announced. Nothing is retried, nothing propagates.
    class TranslationFailed <<record>> {
      -ProviderName: string
      -Reason: string
    }
    class ReferenceFoodCached <<record>> {
      -ReferenceFoodId: int
      -LocalName: string
    }
    class FoodSearchPerformed <<record>> {
      -Term: string
      -ResultCount: int
      -ExternalProvidersConsulted: bool
    }
    class LocalFoodOverrideCreated <<record>> {
      -ReferenceFoodId: int
      -PractitionerId: int
      -LocalName: string
    }
  }

  package "Model.Errors" {
    enum FoodCatalogError {
      ExternalCatalogUnavailable
      TaxonomyTranslationFailed
      ExternalIdNotAllowed
      SourceHashRequired
      ReferenceFoodNotFound
      PractitionerOnly
      LocalNameAndNutrientsRequired
      DuplicatedLocalOverride
      UnexpectedError
    }
  }

  package "Repositories" {
    interface IReferenceFoodRepository {
      +FindBySourceHashAsync(sourceHash: SourceHash, ct): Task<ReferenceFood?>
      +SearchByLocalNameAsync(term: string, max: int, ct): Task<IEnumerable<ReferenceFood>>
      +ListLocalCatalogAsync(max: int, ct): Task<IEnumerable<ReferenceFood>>
      +ExistsLocalOverrideWithNameAsync(localName: string, ct): Task<bool>
      +CountAsync(ct): Task<int>
    }
  }

  package "Services" {
    ' One upstream record, already expressed in this platform's vocabulary.
    ' The absence of an identifier field is the rule, compiled: an adapter has
    ' nowhere to put one even if it wanted to.
    class ExternalFoodRecord <<record>> {
      -LocalName: LocalName
      -Nutrients: NutrientsPer100g
      -SourceHash: SourceHash
    }
    ' A record either translates completely or it is reported and dropped.
    ' There is no partial third state.
    class ExternalCatalogSnapshot <<record>> {
      -ProviderName: string
      -TranslatedFoods: IReadOnlyList<ExternalFoodRecord>
      -TranslationFailures: IReadOnlyList<string>
    }
    ' The anti-corruption layer, seen from the inside. The domain knows that
    ' snapshots arrive and that some records do not translate; it does not know
    ' that anyone speaks HTTP.
    interface IExternalFoodCatalogProvider {
      +ProviderName: string
      +FetchSnapshotAsync(term: string, max: int, ct): Task<ExternalCatalogSnapshot>
    }
  }
}

package "Shared.Domain" <<external>> {
  interface IAuditableEntity
  interface "IBaseRepository<T>" as IBaseRepository
  abstract DomainEventBase
}

' --- Aggregate root & auditing ---
ReferenceFood ..|> IAuditableEntity

' --- Identity & value objects held by the aggregate ---
ReferenceFood *--> "1" ReferenceFoodId : identified by
ReferenceFood *--> "1" SourceHash : fingerprinted by (unique)
ReferenceFood ..> LocalName : rebuilt from local_name
ReferenceFood ..> NutrientsPer100g : rebuilt from four columns
' A local override still needs a digest, because the hash is what makes
' importing and seeding idempotent.
SourceHash ..> LocalName : ForLocalOverride derives from

' --- Aggregate construction & invariants ---
ReferenceFood ..> CacheFoodLocallyCommand : cached from
ReferenceFood ..> CreateLocalOverrideCommand : built from
ReferenceFood ..> ImportCatalogSnapshotCommand : refreshed by an import of
SearchFoodCommand ..> ReferenceFood : searches

' --- Repository ---
IReferenceFoodRepository --|> IBaseRepository
IReferenceFoodRepository ..> ReferenceFood : manages
IReferenceFoodRepository ..> SourceHash : idempotency key
IReferenceFoodRepository ..> LocalName : matches on

' --- Anti-corruption layer contract ---
IExternalFoodCatalogProvider ..> ExternalCatalogSnapshot : returns
ExternalCatalogSnapshot o--> "0..*" ExternalFoodRecord : TranslatedFoods
ExternalFoodRecord *--> "1" LocalName : translated name
ExternalFoodRecord *--> "1" NutrientsPer100g : translated nutrients
ExternalFoodRecord *--> "1" SourceHash : upstream fingerprint
ExternalFoodRecord ..> ReferenceFood : becomes, once cached

' --- Queries target their read models ---
GetReferenceFoodByIdQuery ..> ReferenceFood : queries
SearchReferenceFoodsQuery ..> ReferenceFood : queries
GetLocalFoodCatalogQuery ..> ReferenceFood : queries

' --- Domain events ---
ExternalCatalogSnapshotImported --|> DomainEventBase
ReferenceFoodTranslated --|> DomainEventBase
TranslationFailed --|> DomainEventBase
ReferenceFoodCached --|> DomainEventBase
FoodSearchPerformed --|> DomainEventBase
LocalFoodOverrideCreated --|> DomainEventBase

ExternalCatalogSnapshot ..> ExternalCatalogSnapshotImported : raises
ExternalFoodRecord ..> ReferenceFoodTranslated : raises
ExternalCatalogSnapshot ..> TranslationFailed : raises per dropped record
ReferenceFood ..> ReferenceFoodCached : raises
ReferenceFood ..> FoodSearchPerformed : searching raises
ReferenceFood ..> LocalFoodOverrideCreated : raises

' --- The one door into the catalog, expressed as a policy chain ---
ReferenceFoodTranslated ..> CacheFoodLocallyCommand : policy issues

' --- Errors: one value per business rule this context enforces ---
FoodCatalogError ..> ReferenceFood : reports failures of
FoodCatalogError ..> ExternalCatalogSnapshot : reports failures of

@enduml
