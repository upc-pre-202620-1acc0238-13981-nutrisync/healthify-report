@startuml Healthify - Food Catalog - Infrastructure

skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam linetype ortho
hide empty members

package "Healthify.Platform.FoodCatalog.Infrastructure" {

  package "External.OpenFoodFacts" {
    class OpenFoodFactsProvider {
      +ProviderName: string = "Open Food Facts"
      +FetchSnapshotAsync(term: string, max: int, ct): Task<ExternalCatalogSnapshot>
      -Translate(document: JsonDocument): ExternalCatalogSnapshot
      -Unavailable(reason: string): ExternalCatalogSnapshot
      -{static} ReadString(element: JsonElement, property: string): string?
      -{static} ReadDecimal(element: JsonElement, property: string): decimal?
    }
  }

  package "External.Usda" {
    class UsdaFoodDataProvider {
      -{static} EnergyKcalNutrientNumber: string = "208"
      -{static} ProteinNutrientNumber: string = "203"
      -{static} CarbohydrateNutrientNumber: string = "205"
      -{static} FatNutrientNumber: string = "204"
      +ProviderName: string = "USDA FoodData Central"
      +FetchSnapshotAsync(term: string, max: int, ct): Task<ExternalCatalogSnapshot>
      -Translate(document: JsonDocument): ExternalCatalogSnapshot
      -{static} ReadNutrients(food: JsonElement): NutrientsPer100g?
      -Unavailable(reason: string): ExternalCatalogSnapshot
      -{static} ReadIdentifier(element: JsonElement, property: string): string?
      -{static} ReadString(element: JsonElement, property: string): string?
      -{static} ReadDecimal(element: JsonElement, property: string): decimal?
    }
  }

  package "Persistence.EFC.Configuration" {
    class ReferenceFoodEntityTypeConfiguration {
      +Configure(builder: EntityTypeBuilder<ReferenceFood>): void
    }
  }

  package "Persistence.EFC.Repositories" {
    class ReferenceFoodRepository {
      +FindByIdAsync(id: int, ct): Task<ReferenceFood?>
      +FindBySourceHashAsync(sourceHash: SourceHash, ct): Task<ReferenceFood?>
      +SearchByLocalNameAsync(term: string, max: int, ct): Task<IEnumerable<ReferenceFood>>
      +ListLocalCatalogAsync(max: int, ct): Task<IEnumerable<ReferenceFood>>
      +ExistsLocalOverrideWithNameAsync(localName: string, ct): Task<bool>
      +CountAsync(ct): Task<int>
    }
  }

  package "Persistence.EFC.Seeders" {
    class ReferenceFoodSeeder {
      -{static} SeedProvenance: string = "healthify-seed-peru"
      -{static} StartingCatalog: (string, decimal, decimal, decimal, decimal)[]
      +SeedAsync(ct): Task
    }
  }

  package "Scheduling" {
    class CatalogImportHostedService {
      -{static} RecordsPerProvider: int = 50
      #ExecuteAsync(stoppingToken: CancellationToken): Task
      -RunCycleAsync(stoppingToken: CancellationToken): Task
      -{static} SafeWaitAsync(timer: PeriodicTimer, stoppingToken): Task<bool>
    }
  }
}

package "FoodCatalog.Domain" <<external>> {
  class ReferenceFood
  class ReferenceFoodId
  class LocalName
  class NutrientsPer100g
  class SourceHash
  class ExternalFoodRecord
  class ExternalCatalogSnapshot
  interface IExternalFoodCatalogProvider
  interface IReferenceFoodRepository
  class ImportCatalogSnapshotCommand
  class CacheFoodLocallyCommand
}

package "FoodCatalog.Application" <<external>> {
  interface IReferenceFoodCommandService
  class CatalogImportSummary
}

package "Shared.Infrastructure / EF Core" <<external>> {
  class AppDbContext
  class "BaseRepository<T>" as BaseRepository
  interface "IBaseRepository<T>" as IBaseRepository
  interface "IEntityTypeConfiguration<T>" as IEntityTypeConfiguration
  class AuditableEntityInterceptor
}

package "ASP.NET hosting / BCL" <<external>> {
  abstract BackgroundService
  interface IServiceScopeFactory
  interface IConfiguration
  interface "ILogger<T>" as ILogger
  class PeriodicTimer
  class HttpClient
  class JsonDocument
}

OpenFoodFactsProvider ..|> IExternalFoodCatalogProvider
UsdaFoodDataProvider ..|> IExternalFoodCatalogProvider
OpenFoodFactsProvider --> HttpClient : calls
OpenFoodFactsProvider --> IConfiguration : reads the country filter from
OpenFoodFactsProvider --> ILogger : logs to
OpenFoodFactsProvider --> JsonDocument : parses
UsdaFoodDataProvider --> HttpClient : calls
UsdaFoodDataProvider --> IConfiguration : reads the API key from
UsdaFoodDataProvider --> ILogger : logs to
UsdaFoodDataProvider --> JsonDocument : parses
OpenFoodFactsProvider ..> ExternalCatalogSnapshot : returns
OpenFoodFactsProvider ..> ExternalFoodRecord : translates into
OpenFoodFactsProvider ..> LocalName : builds
OpenFoodFactsProvider ..> NutrientsPer100g : builds
OpenFoodFactsProvider ..> SourceHash : digests the upstream key into
UsdaFoodDataProvider ..> ExternalCatalogSnapshot : returns
UsdaFoodDataProvider ..> ExternalFoodRecord : translates into
UsdaFoodDataProvider ..> LocalName : builds
UsdaFoodDataProvider ..> NutrientsPer100g : builds
UsdaFoodDataProvider ..> SourceHash : digests the upstream key into

ReferenceFoodEntityTypeConfiguration ..|> IEntityTypeConfiguration
ReferenceFoodEntityTypeConfiguration ..> ReferenceFood : maps to table reference_foods
ReferenceFoodEntityTypeConfiguration ..> ReferenceFoodId : converts
ReferenceFoodEntityTypeConfiguration ..> SourceHash : converts (unique index)
ReferenceFoodEntityTypeConfiguration ..> LocalName : MaxLength drives the column
AppDbContext ..> ReferenceFoodEntityTypeConfiguration : applies
AppDbContext --> AuditableEntityInterceptor : stamps created_at / updated_at

ReferenceFoodRepository --|> BaseRepository
BaseRepository ..|> IBaseRepository
ReferenceFoodRepository ..|> IReferenceFoodRepository
ReferenceFoodRepository --> AppDbContext : queries
ReferenceFoodRepository ..> ReferenceFood : persists
ReferenceFoodRepository ..> ReferenceFoodId : rebuilds typed id
ReferenceFoodRepository ..> SourceHash : looks up by

ReferenceFoodSeeder --> IReferenceFoodRepository : counts with
ReferenceFoodSeeder --> IReferenceFoodCommandService : writes through
ReferenceFoodSeeder --> IConfiguration : reads Seeder settings from
ReferenceFoodSeeder --> ILogger : logs to
ReferenceFoodSeeder ..> CacheFoodLocallyCommand : issues
ReferenceFoodSeeder ..> SourceHash : builds a stable digest per entry

CatalogImportHostedService --|> BackgroundService
CatalogImportHostedService --> IServiceScopeFactory : opens its own scope with
CatalogImportHostedService --> IConfiguration : reads the interval and the term from
CatalogImportHostedService --> ILogger : logs to
CatalogImportHostedService --> PeriodicTimer : paces cycles with
CatalogImportHostedService --> IReferenceFoodCommandService : issues the command through
CatalogImportHostedService ..> ImportCatalogSnapshotCommand : issues
CatalogImportHostedService ..> CatalogImportSummary : reports

@enduml
