@startuml Healthify - Care Relationship - Domain

skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam linetype ortho
hide empty members

package "Healthify.Platform.CareRelationship.Domain" {

  package "Model.Aggregates" {
    class Invitation {
      -Id: InvitationId
      -IssuedBy: int
      -Token: InvitationToken
      -ExpiresAt: DateTimeOffset
      -RedeemedAt: DateTimeOffset?
      -ExpiredAt: DateTimeOffset?
      -CreatedAt: DateTimeOffset?
      -UpdatedAt: DateTimeOffset?
      +IsRedeemed: bool <<derived>>
      +IsExpired: bool <<derived>>
      #Invitation()
      +Invitation(command: IssueInvitationCommand)
      +IsValidAt(moment: DateTimeOffset): bool
      +Redeem(redeemedAt: DateTimeOffset): void
      +Expire(expiredAt: DateTimeOffset): void
    }

    class CareLink {
      -Id: CareLinkId
      -PatientId: int
      -PractitionerId: int
      -EstablishedAt: DateTimeOffset
      -RevokedAt: DateTimeOffset?
      -DischargedAt: DateTimeOffset?
      -DischargeReason: string?
      -PendingTargetsVersion: int?
      -LastAcknowledgedVersion: int?
      -ConsentGranted: bool
      -ConsentScope: string?
      -ConsentGrantedAt: DateTimeOffset?
      -ConsentWithdrawnAt: DateTimeOffset?
      -CreatedAt: DateTimeOffset?
      -UpdatedAt: DateTimeOffset?
      +Consent: Consent? <<derived>>
      +IsActive: bool <<derived>>
      +IsRevoked: bool <<derived>>
      +IsDischarged: bool <<derived>>
      #CareLink()
      +CareLink(command: EstablishCareLinkCommand)
      +GrantConsent(command: GrantConsentCommand): void
      +WithdrawConsent(): void
      +Revoke(): void
      +Discharge(reason: ClinicalReason): void
      +MarkTargetsPending(planVersion: int): void
      +AcknowledgeActiveTargets(planVersion: int): void
    }
  }

  package "Model.ValueObjects" {
    class InvitationId <<record>> {
      -Value: int
      +InvitationId(value: int)
      +{static} FromRaw(value: int): InvitationId
    }
    class CareLinkId <<record>> {
      -Value: int
      +CareLinkId(value: int)
      +{static} FromRaw(value: int): CareLinkId
    }
    class InvitationToken <<record>> {
      -{static} ByteLength: int = 32
      -{static} MinimumLength: int = 22
      -{static} MaximumLength: int = 64
      -Value: string
      +InvitationToken(value: string)
      +{static} Generate(): InvitationToken
      +ToString(): string
    }
    class Consent <<record>> {
      -{static} MaximumScopeLength: int = 200
      -IsGranted: bool
      -Scope: string
      -GrantedAt: DateTimeOffset
      -WithdrawnAt: DateTimeOffset?
      +Consent(isGranted, scope, grantedAt, withdrawnAt)
      +Withdraw(withdrawnAt: DateTimeOffset): Consent
    }
    class ClinicalReason <<record>> {
      -{static} MaximumLength: int = 500
      -Value: string
      +ClinicalReason(value: string)
      +ToString(): string
    }
  }

  package "Model.Commands" {
    class IssueInvitationCommand <<record>> {
      -IssuedBy: int
      -ExpiresAt: DateTimeOffset
    }
    class ExpireInvitationCommand <<record>> {
      -InvitationId: int
    }
    class RedeemInvitationCommand <<record>> {
      -Token: string
      -PatientId: int
    }
    class EstablishCareLinkCommand <<record>> {
      -PatientId: int
      -PractitionerId: int
      -InvitationId: int
    }
    class GrantConsentCommand <<record>> {
      -CareLinkId: int
      -PatientId: int
      -Scope: string
    }
    class WithdrawConsentCommand <<record>> {
      -CareLinkId: int
      -PatientId: int
    }
    class RevokeCareLinkCommand <<record>> {
      -CareLinkId: int
    }
    class DischargePatientCommand <<record>> {
      -CareLinkId: int
      -PractitionerId: int
      -ClinicalReason: string
    }
    class MarkTargetsPendingAcknowledgementCommand <<record>> {
      -PatientId: int
      -PlanVersion: int
    }
    class AcknowledgeActiveTargetsCommand <<record>> {
      -CareLinkId: int
      -PatientId: int
      -PlanVersion: int
    }
  }

  package "Model.Queries" {
    class GetInvitationByIdQuery <<record>> {
      -InvitationId: int
    }
    class GetInvitationByTokenQuery <<record>> {
      -Token: string
    }
    class GetExpirableInvitationsQuery <<record>> {
      -AsOf: DateTimeOffset
      -MaxResults: int
    }
    class GetCareLinkByIdQuery <<record>> {
      -CareLinkId: int
    }
    class GetActiveCareLinkByPatientIdQuery <<record>> {
      -PatientId: int
    }
    class GetCareLinksByPractitionerIdQuery <<record>> {
      -PractitionerId: int
    }
  }

  package "Model.Events" {
    class InvitationIssued <<record>> {
      -InvitationId: int
      -IssuedBy: int
      -ExpiresAt: DateTimeOffset
    }
    class InvitationExpired <<record>> {
      -InvitationId: int
      -IssuedBy: int
      -ExpiredAt: DateTimeOffset
    }
    class InvitationRedeemed <<record>> {
      -InvitationId: int
      -PatientId: int
      -PractitionerId: int
    }
    class CareLinkEstablished <<record>> {
      -CareLinkId: int
      -PatientId: int
      -PractitionerId: int
    }
    class ConsentGranted <<record>> {
      -CareLinkId: int
      -PatientId: int
      -PractitionerId: int
      -Scope: string
    }
    class ConsentWithdrawn <<record>> {
      -CareLinkId: int
      -PatientId: int
      -WithdrawnAt: DateTimeOffset
    }
    class CareLinkRevoked <<record>> {
      -CareLinkId: int
      -PatientId: int
      -PractitionerId: int
      -RevokedAt: DateTimeOffset
    }
    class TreatmentDischarged <<record>> {
      -CareLinkId: int
      -PatientId: int
      -PractitionerId: int
      -ClinicalReason: string
      -DischargedAt: DateTimeOffset
    }
    class TargetsPendingAcknowledgement <<record>> {
      -CareLinkId: int
      -PatientId: int
      -PlanVersion: int
    }
    class ActiveTargetsAcknowledged <<record>> {
      -CareLinkId: int
      -PatientId: int
      -PlanVersion: int
    }
  }

  package "Model.Errors" {
    enum CareRelationshipError {
      PractitionerOnly
      ExpirationDateRequired
      InvitationNotFound
      InvitationExpired
      InvitationAlreadyRedeemed
      InvitationNotValid
      RedeemedInvitationCannotExpire
      PatientCannotSelfLink
      PatientAlreadyHasActiveLink
      CareLinkNotFound
      ConsentScopeRequired
      ConsentAlreadyGranted
      NoActiveConsent
      PendingVersionAlreadyExists
      NoPendingTargetsVersion
      AcknowledgedVersionNewerThanActive
      ClinicalReasonRequired
      CareLinkAlreadyRevoked
      DischargedLinkCannotBeReactivated
      CareLinkNotActive
      UnexpectedError
    }
  }

  package "Repositories" {
    interface IInvitationRepository {
      +FindByTokenAsync(token: InvitationToken, ct): Task<Invitation?>
      +ListExpirableAsync(asOf: DateTimeOffset, maxResults: int, ct): Task<IEnumerable<Invitation>>
    }
    interface ICareLinkRepository {
      +FindActiveByPatientIdAsync(patientId: int, ct): Task<CareLink?>
      +FindUnclosedByPatientIdAsync(patientId: int, ct): Task<CareLink?>
      +ExistsUnclosedByPatientIdAsync(patientId: int, ct): Task<bool>
      +ListByPractitionerIdAsync(practitionerId: int, ct): Task<IEnumerable<CareLink>>
    }
  }
}

package "NutritionalCare.Domain.Model.Events" <<external>> {
  class ActiveTargetsUpdated
}

package "Shared.Domain" <<external>> {
  interface IAuditableEntity
  interface "IBaseRepository<T>" as IBaseRepository
  abstract DomainEventBase
}

Invitation ..|> IAuditableEntity
CareLink ..|> IAuditableEntity
Invitation "1" ..> "0..1" CareLink : redemption establishes

Invitation *--> "1" InvitationId : identified by
Invitation *--> "1" InvitationToken : single-use secret
CareLink *--> "1" CareLinkId : identified by
CareLink *--> "0..1" Consent : rebuilt from four columns
CareLink ..> ClinicalReason : recorded at discharge
Consent ..> ClinicalReason : asymmetry - no reason asked to withdraw

Invitation ..> IssueInvitationCommand : built from
Invitation ..> RedeemInvitationCommand : redeemed by
Invitation ..> ExpireInvitationCommand : expired by
CareLink ..> EstablishCareLinkCommand : built from
CareLink ..> GrantConsentCommand : applies
CareLink ..> WithdrawConsentCommand : applies
CareLink ..> RevokeCareLinkCommand : applies
CareLink ..> DischargePatientCommand : applies
CareLink ..> MarkTargetsPendingAcknowledgementCommand : applies
CareLink ..> AcknowledgeActiveTargetsCommand : applies

IInvitationRepository --|> IBaseRepository
ICareLinkRepository --|> IBaseRepository
IInvitationRepository ..> Invitation : manages
ICareLinkRepository ..> CareLink : manages

GetInvitationByIdQuery ..> Invitation : queries
GetInvitationByTokenQuery ..> Invitation : queries
GetExpirableInvitationsQuery ..> Invitation : queries
GetCareLinkByIdQuery ..> CareLink : queries
GetActiveCareLinkByPatientIdQuery ..> CareLink : queries
GetCareLinksByPractitionerIdQuery ..> CareLink : queries

InvitationIssued --|> DomainEventBase
InvitationExpired --|> DomainEventBase
InvitationRedeemed --|> DomainEventBase
CareLinkEstablished --|> DomainEventBase
ConsentGranted --|> DomainEventBase
ConsentWithdrawn --|> DomainEventBase
CareLinkRevoked --|> DomainEventBase
TreatmentDischarged --|> DomainEventBase
TargetsPendingAcknowledgement --|> DomainEventBase
ActiveTargetsAcknowledged --|> DomainEventBase

Invitation ..> InvitationIssued : raises
Invitation ..> InvitationExpired : raises
Invitation ..> InvitationRedeemed : raises
CareLink ..> CareLinkEstablished : raises
CareLink ..> ConsentGranted : raises
CareLink ..> ConsentWithdrawn : raises
CareLink ..> CareLinkRevoked : raises
CareLink ..> TreatmentDischarged : raises
CareLink ..> TargetsPendingAcknowledgement : raises
CareLink ..> ActiveTargetsAcknowledged : raises

InvitationRedeemed ..> EstablishCareLinkCommand : policy issues
ConsentWithdrawn ..> RevokeCareLinkCommand : policy issues
ActiveTargetsUpdated ..> MarkTargetsPendingAcknowledgementCommand : policy issues

CareRelationshipError ..> Invitation : reports failures of
CareRelationshipError ..> CareLink : reports failures of

@enduml
