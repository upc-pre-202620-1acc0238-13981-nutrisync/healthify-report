@startuml Healthify - Intake and Body Response - Domain

skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam linetype ortho
hide empty members

package "Healthify.Platform.IntakeBodyResponse.Domain" {

  package "Model.Aggregates" {
    class ActiveTargetsCache {
      -PatientId: int <<key>>
      -PlanVersion: int
      -ValidFrom: DateTimeOffset
      -EnergyKcal: decimal
      -ProteinG: decimal
      -CarbG: decimal
      -FatG: decimal
      -RefreshedAt: DateTimeOffset
      -_guidelines: List<string>
      -_restrictions: List<string>
      -CreatedAt: DateTimeOffset?
      -UpdatedAt: DateTimeOffset?
      +Guidelines: IReadOnlyList<string>
      +Restrictions: IReadOnlyList<string>
      #ActiveTargetsCache()
      +ActiveTargetsCache(command: RefreshActiveTargetsCacheCommand)
      +Refresh(command: RefreshActiveTargetsCacheCommand): void
      -Apply(command: RefreshActiveTargetsCacheCommand): void
    }

    class DiaryEntry {
      -Id: DiaryEntryId
      -PatientId: int
      -LocalTimestamp: DateTime
      -LocalUtcOffsetMinutes: int
      -Provenance: Provenance
      -PhotoRef: string?
      -ProposedReferenceFoodId: int?
      -ProposedPortionGrams: decimal?
      -ProposedConfidence: decimal?
      -ProposedEstimatedAt: DateTimeOffset?
      -ConfirmedReferenceFoodId: int?
      -ConfirmedPortionGrams: decimal?
      -ConfirmedAt: DateTimeOffset?
      -SyncState: SyncState
      -ClientEntryId: Guid?
      -CreatedAt: DateTimeOffset?
      -UpdatedAt: DateTimeOffset?
      +DeclaredLocalTimestamp: DateTimeOffset <<derived>>
      +ProposedEstimate: ProposedEstimate? <<derived>>
      +ConfirmedEstimate: ConfirmedEstimate? <<derived>>
      +HasProposedEstimate: bool <<derived>>
      +HasConfirmedEstimate: bool <<derived>>
      +LocalDate: DateOnly <<derived>>
      #DiaryEntry()
      +DiaryEntry(patientId, localTimestamp, provenance, syncState, photoRef, clientEntryId)
      +ProposeEstimate(estimate: ProposedEstimate): void
      +ConfirmProposedEstimate(): void
      +AdjustProposedEstimate(referenceFoodId: int, portionGrams: decimal): void
      +ConfirmDirectly(estimate: ConfirmedEstimate): void
      +MarkSynchronized(): void
      +MarkConflicted(): void
      +ResolveWithLatest(referenceFoodId, portionGrams, confirmedAt): bool
      -StoreConfirmation(referenceFoodId: int, portionGrams: decimal): void
    }

    class SelfWeighIn {
      -Id: SelfWeighInId
      -PatientId: int
      -ValueKg: decimal
      -LocalTimestamp: DateTime
      -LocalUtcOffsetMinutes: int
      -ProtocolFastedState: bool
      -ProtocolSameTimeOfDay: bool
      -ProtocolSameScale: bool
      -CreatedAt: DateTimeOffset?
      -UpdatedAt: DateTimeOffset?
      +DeclaredLocalTimestamp: DateTimeOffset <<derived>>
      +ProtocolCompliance: ProtocolCompliance <<derived>>
      +FollowsProtocol: bool <<derived>>
      +LocalDate: DateOnly <<derived>>
      #SelfWeighIn()
      +SelfWeighIn(patientId, valueKg, localTimestamp, protocolCompliance)
    }

    class WeightTrend {
      +{static} DefaultWindowSize: int = 7
      -PatientId: int <<key>>
      -WindowSize: int
      -LastRecalculatedAt: DateTimeOffset
      -_points: List<WeightTrendPoint>
      -CreatedAt: DateTimeOffset?
      -UpdatedAt: DateTimeOffset?
      +Points: IReadOnlyList<WeightTrendPoint>
      +HasPoints: bool <<derived>>
      #WeightTrend()
      +WeightTrend(patientId: int, windowSize: int = 7)
      +Recalculate(weighIns: IReadOnlyList<SelfWeighIn>): IReadOnlyList<int>
    }
  }

  package "Model.ValueObjects" {
    class DiaryEntryId <<record>> {
      -Value: int
      +{static} FromRaw(value: int): DiaryEntryId
    }
    class SelfWeighInId <<record>> {
      -Value: int
      +{static} FromRaw(value: int): SelfWeighInId
    }
    class LocalTimestamp <<record>> {
      -{static} MaximumFutureSkew: TimeSpan = 24h
      -Value: DateTimeOffset
      +Date: DateOnly <<derived>>
      +LocalTimestamp(value: DateTimeOffset)
    }
    class Confidence <<record>> {
      -Value: decimal
      +Confidence(value: decimal)
    }
    class WeightKg <<record>> {
      +{static} Minimum: decimal = 20
      +{static} Maximum: decimal = 400
      -Value: decimal
      +WeightKg(value: decimal)
    }
    class Provenance <<record>> {
      +{static} Photo: string
      +{static} Manual: string
      +{static} OffPlan: string
      -Value: string
      +IsPhoto: bool <<derived>>
      +IsManual: bool <<derived>>
      +IsOffPlan: bool <<derived>>
    }
    class SyncState <<record>> {
      +{static} Pending: string
      +{static} Synced: string
      +{static} Conflicted: string
      -Value: string
      +IsPending: bool <<derived>>
      +IsSynced: bool <<derived>>
      +IsConflicted: bool <<derived>>
    }
    class ProposedEstimate <<record>> {
      -ReferenceFoodId: int
      -PortionGrams: decimal
      -Confidence: Confidence
      -EstimatedAt: DateTimeOffset
    }
    class ConfirmedEstimate <<record>> {
      -ReferenceFoodId: int
      -PortionGrams: decimal
      -ConfirmedAt: DateTimeOffset
    }
    class ProtocolCompliance <<record>> {
      -FastedState: bool
      -SameTimeOfDay: bool
      -SameScale: bool
      +FollowsProtocol: bool <<derived>>
    }
    class WeightTrendPoint <<record>> {
      -Date: DateOnly
      -SmoothedValueKg: decimal
    }
  }

  package "Model.Commands" {
    class RefreshActiveTargetsCacheCommand <<record>>
    class LogMealByPhotoCommand <<record>>
    class EstimatePortionCommand <<record>>
    class ConfirmEstimateCommand <<record>>
    class AdjustEstimateCommand <<record>>
    class LogMealManuallyCommand <<record>>
    class LogOffPlanMealCommand <<record>> {
      -PatientId: int
      -LocalTimestamp: DateTimeOffset
    }
    class RecordSelfWeighInCommand <<record>>
    class RecalculateWeightTrendCommand <<record>> {
      -PatientId: int
    }
    class PendingDiaryEntry <<record>> {
      -ClientEntryId: Guid
      -LocalTimestamp: DateTimeOffset
      -Provenance: string
      -PhotoRef: string?
      -ReferenceFoodId: int?
      -PortionGrams: decimal?
      -Confidence: decimal?
    }
    class SyncPendingEntriesCommand <<record>> {
      -PatientId: int
      -Entries: IReadOnlyList<PendingDiaryEntry>
    }
  }

  package "Model.Queries" {
    class GetActiveTargetsByPatientIdQuery <<record>>
    class GetDiaryEntryByIdQuery <<record>>
    class GetDiaryEntriesByPatientIdQuery <<record>>
    class GetPendingSyncQueueByPatientIdQuery <<record>>
    class GetSelfWeighInsByPatientIdQuery <<record>>
    class GetWeightTrendByPatientIdQuery <<record>>
  }

  package "Model.Events" {
    class ActiveTargetsCacheRefreshed <<record>>
    class MealLogged <<record>> {
      -DiaryEntryId: int
      -PatientId: int
      -LocalTimestamp: DateTimeOffset
      -Provenance: string
      -ProposedReferenceFoodId: int?
      -ProposedPortionGrams: decimal?
      -ProposedConfidence: decimal?
    }
    class EstimateProposed <<record>>
    class EstimateConfirmedByPatient <<record>>
    class EstimateAdjustedByPatient <<record>>
    class OffPlanEntryLogged <<record>>
    class SelfWeighInRecorded <<record>>
    class WeightTrendRecalculated <<record>>
    class SelfWeighInExcludedFromTrend <<record>>
    class EntryQueuedOffline <<record>>
    class EntrySynchronized <<record>>
    class SyncConflictResolved <<record>>
  }

  package "Model.Errors" {
    enum IntakeError {
      ActiveTargetsCacheNotFound
      PublishedContractOnly
      ProvenanceRequired
      LocalTimestampRequired
      RetroactiveLoggingWindowExceeded
      DiaryEntryNotFound
      DiaryEntryCannotBeDeleted
      ReferenceFoodNotResolved
      EstimateNotProposed
      EstimateAlreadyConfirmed
      ConfidenceRequired
      ImplausibleWeightValue
      ProtocolComplianceRequired
      SelfWeighInNotFound
      WeightTrendNotFound
      DuplicatedClientEntryId
      LocalTimestampCannotBeRewritten
      PatientWriteOnly
      ActiveCareLinkRequired
      UnexpectedError
    }
  }

  package "Repositories" {
    interface IActiveTargetsCacheRepository {
      +FindByPatientIdAsync(patientId: int, ct): Task<ActiveTargetsCache?>
    }
    interface IDiaryEntryRepository {
      +ListByPatientIdAsync(patientId: int, date: DateOnly?, ct): Task<IEnumerable<DiaryEntry>>
      +FindByClientEntryIdAsync(clientEntryId: Guid, ct): Task<DiaryEntry?>
      +ListUnreconciledByPatientIdAsync(patientId: int, ct): Task<IEnumerable<DiaryEntry>>
    }
    interface ISelfWeighInRepository {
      +ListByPatientIdAsync(patientId: int, ct): Task<IEnumerable<SelfWeighIn>>
    }
    interface IWeightTrendRepository {
      +FindByPatientIdAsync(patientId: int, ct): Task<WeightTrend?>
    }
  }
}

package "Shared.Domain" <<external>> {
  interface IAuditableEntity
  interface "IBaseRepository<T>" as IBaseRepository
  abstract DomainEventBase
}

package "FoodCatalog.Interfaces.Acl" <<external>> {
  class ReferenceFoodItem <<record>>
}

ActiveTargetsCache ..|> IAuditableEntity
DiaryEntry ..|> IAuditableEntity
SelfWeighIn ..|> IAuditableEntity
WeightTrend ..|> IAuditableEntity

WeightTrend "1" ..> "0..*" SelfWeighIn : smoothed from
ActiveTargetsCache "1" ..> "0..*" DiaryEntry : what the day is aimed at
DiaryEntry ..> ReferenceFoodItem : resolves its food through the ACL

DiaryEntry *--> "1" DiaryEntryId : identified by
DiaryEntry *--> "1" Provenance : Photo, Manual or OffPlan
DiaryEntry *--> "1" SyncState : Pending, Synced or Conflicted
DiaryEntry *--> "0..1" ProposedEstimate : what a model guessed
DiaryEntry *--> "0..1" ConfirmedEstimate : what the person said
DiaryEntry ..> LocalTimestamp : declared with
SelfWeighIn *--> "1" SelfWeighInId : identified by
SelfWeighIn *--> "1" ProtocolCompliance : declared with
SelfWeighIn ..> WeightKg : validated as
SelfWeighIn ..> LocalTimestamp : declared with
WeightTrend *--> "0..*" WeightTrendPoint : smoothed series
ProposedEstimate *--> "1" Confidence : always attached
ProposedEstimate ..> ConfirmedEstimate : confirmed or corrected into
ProtocolCompliance ..> WeightTrendPoint : only compliant readings smooth a point

ActiveTargetsCache ..> RefreshActiveTargetsCacheCommand : built from / refreshed by
DiaryEntry ..> LogMealByPhotoCommand : built from
DiaryEntry ..> LogMealManuallyCommand : built from
DiaryEntry ..> LogOffPlanMealCommand : built from
DiaryEntry ..> EstimatePortionCommand : applies
DiaryEntry ..> ConfirmEstimateCommand : applies
DiaryEntry ..> AdjustEstimateCommand : applies
DiaryEntry ..> PendingDiaryEntry : reconciled from
SyncPendingEntriesCommand o--> "0..*" PendingDiaryEntry : batch of
SelfWeighIn ..> RecordSelfWeighInCommand : built from
WeightTrend ..> RecalculateWeightTrendCommand : applies

IActiveTargetsCacheRepository --|> IBaseRepository
IDiaryEntryRepository --|> IBaseRepository
ISelfWeighInRepository --|> IBaseRepository
IWeightTrendRepository --|> IBaseRepository
IActiveTargetsCacheRepository ..> ActiveTargetsCache : manages
IDiaryEntryRepository ..> DiaryEntry : manages
IDiaryEntryRepository ..> SyncState : filters the pending queue by
ISelfWeighInRepository ..> SelfWeighIn : manages
IWeightTrendRepository ..> WeightTrend : manages

GetActiveTargetsByPatientIdQuery ..> ActiveTargetsCache : queries
GetDiaryEntryByIdQuery ..> DiaryEntry : queries
GetDiaryEntriesByPatientIdQuery ..> DiaryEntry : queries
GetPendingSyncQueueByPatientIdQuery ..> DiaryEntry : queries
GetSelfWeighInsByPatientIdQuery ..> SelfWeighIn : queries
GetWeightTrendByPatientIdQuery ..> WeightTrend : queries

ActiveTargetsCacheRefreshed --|> DomainEventBase
MealLogged --|> DomainEventBase
EstimateProposed --|> DomainEventBase
EstimateConfirmedByPatient --|> DomainEventBase
EstimateAdjustedByPatient --|> DomainEventBase
OffPlanEntryLogged --|> DomainEventBase
SelfWeighInRecorded --|> DomainEventBase
WeightTrendRecalculated --|> DomainEventBase
SelfWeighInExcludedFromTrend --|> DomainEventBase
EntryQueuedOffline --|> DomainEventBase
EntrySynchronized --|> DomainEventBase
SyncConflictResolved --|> DomainEventBase

ActiveTargetsCache ..> ActiveTargetsCacheRefreshed : raises
DiaryEntry ..> MealLogged : raises
DiaryEntry ..> EstimateProposed : raises
DiaryEntry ..> EstimateConfirmedByPatient : raises
DiaryEntry ..> EstimateAdjustedByPatient : raises
DiaryEntry ..> OffPlanEntryLogged : raises
DiaryEntry ..> EntryQueuedOffline : raises
DiaryEntry ..> EntrySynchronized : raises
DiaryEntry ..> SyncConflictResolved : raises
SelfWeighIn ..> SelfWeighInRecorded : raises
WeightTrend ..> WeightTrendRecalculated : raises
WeightTrend ..> SelfWeighInExcludedFromTrend : raises per kept-but-excluded reading

MealLogged ..> EstimatePortionCommand : policy issues (Provenance = Photo)
SelfWeighInRecorded ..> RecalculateWeightTrendCommand : policy issues

IntakeError ..> ActiveTargetsCache : reports failures of
IntakeError ..> DiaryEntry : reports failures of
IntakeError ..> SelfWeighIn : reports failures of
IntakeError ..> WeightTrend : reports failures of

@enduml
