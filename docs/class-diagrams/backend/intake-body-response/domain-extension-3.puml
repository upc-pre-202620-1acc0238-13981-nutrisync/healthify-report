@startuml Healthify - Intake and Body Response - Domain (part 3 of 4)

skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam nodesep 10
skinparam ranksep 14
hide empty members

title Intake and Body Response - Domain layer (part 3 of 4)

package "Healthify.Platform.IntakeBodyResponse.Domain" {

  package "Model.ValueObjects" {
    class MealPhotoPortion {
      +MinimumGrams: decimal
      +MaximumGrams: decimal
    }
    class PlanAdherence <<record>> {
      +InPlan: string
      +OffPlan: string
      +NotAnswered: string
      +PlanAdherence(value: string)
      +Value: string
      +IsInPlan: bool
      +IsOffPlan: bool
      +IsAnswered: bool
      +ToString(): string
    }
    class RemainingTargets <<record>> {
      +MinimumForAMealKcal: decimal
      +EnergyBucketKcal: decimal
      +RemainingTargets(energyKcal: decimal, proteinG: decimal, carbG: decimal, fatG: decimal)
      +EnergyKcal: decimal
      +ProteinG: decimal
      +CarbG: decimal
      +FatG: decimal
      +LeavesRoomForAMeal: bool
      +{static} Of(targetEnergyKcal: decimal, targetProteinG: decimal, targetCarbG: decimal, targetFatG: decimal, eatenEnergyKcal: decimal, eatenProteinG: decimal, eatenCarbG: decimal, eatenFatG: decimal): RemainingTargets
    }
    class SelfWeighInProtocol <<record>> {
      +Fasted: string
      +SameTimeOfDay: string
      +SameScale: string
      +SelfWeighInProtocol(conditions: IEnumerable<string>)
      +Conditions: IReadOnlyList<string>
      +IsFollowedBy(declaration: ProtocolCompliance): bool
      +Equals(other: SelfWeighInProtocol?): bool
      +GetHashCode(): int
    }
    class WeightTrendRange <<record>> {
      -From: DateOnly
      -To: DateOnly
      -Weeks: int
      -ExcludedReadingsCount: int
      -Summary: WeightTrendSummary
      +DefaultWeeks: int
      +MaxWeeks: int
      +{static} ClampWeeks(weeks: int?): int
    }
    class WeightTrendSummary <<record>> {
      -SlopeKgPerWeek: decimal?
      -ChangeKg: decimal?
      -PointCount: int
      +{static} Of(points: IEnumerable<WeightTrendPoint>, from: DateOnly): WeightTrendSummary
    }
  }
  package "Repositories" {
    interface IMealPhotoAnalysisRepository {
      +FindByIdAsync(analysisId: Guid, ct): Task<MealPhotoAnalysis?>
      +DeleteByPatientIdAsync(patientId: int, ct): Task<int>
      +DeleteExpiredAsync(now: DateTimeOffset, ct): Task<int>
    }
  }
  package "Services" {
    interface IPhotoMetadataStripper {
      +Strip(photo: MealPhoto): MealPhoto
    }
  }
}

