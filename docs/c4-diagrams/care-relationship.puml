@startuml CareRelationship_Component_Diagram
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_TOP_DOWN()
LAYOUT_WITH_LEGEND()

title Component Diagram - Bounded Context "Care Relationship" (Container: Healthify Platform API)

Person(practitioner, "Practitioner", "Issues the invitation, discharges the patient and reads the list of linked patients")
Person(patient, "Patient", "Redeems the QR invitation, grants consent, sets the AI preferences and may withdraw consent at any time")

Container(mobile, "Mobile Application", "Flutter / MAUI", "Scans and renders the QR invitation token and shows the state of the care link")

Container_Boundary(api, "Healthify Platform API") {

    Component(invitationsController, "InvitationsController", "ASP.NET Core REST Controller", "api/v1/invitations. Issue and redeem")
    Component(careLinksController, "CareLinksController", "ASP.NET Core REST Controller", "api/v1/care-links. Consent, acknowledgement, revocation and discharge")
    Component(patientCareLinksController, "PatientCareLinksController", "ASP.NET Core REST Controller", "api/v1/patients. Active link and history of a patient")
    Component(practitionerPatientsController, "PractitionerPatientsController", "ASP.NET Core REST Controller", "api/v1/practitioners. Patients linked to a practitioner")
    Component(aiPrefsController, "PatientAiPreferencesController", "ASP.NET Core REST Controller", "api/v1/patients/{id}/ai-preferences. Read and change the AI preferences")
    Component(crAssemblers, "Care Relationship Transform Assemblers", "C# static assemblers", "Maps resources, commands and responses")

    Component(invitationCmdService, "InvitationCommandService", "C# Application Service (CQRS command side)", "Issues, redeems and expires invitations")
    Component(careLinkCmdService, "CareLinkCommandService", "C# Application Service (CQRS command side)", "Establishes, consents, acknowledges targets, revokes and discharges")
    Component(aiPrefsCmdService, "AiPreferencesCommandService", "C# Application Service (CQRS command side)", "Turns each AI function on or off and syncs them with the AI consent")
    Component(invitationQryService, "InvitationQueryService", "C# Application Service (CQRS query side)", "Reads invitations by id or token")
    Component(careLinkQryService, "CareLinkQueryService", "C# Application Service (CQRS query side)", "Reads links by patient or practitioner")
    Component(aiPrefsQryService, "AiPreferencesQueryService", "C# Application Service (CQRS query side)", "Reads the AI preferences and the consent of a patient")

    Component(onRedeemed, "OnInvitationRedeemedHandler", "Cortex.Mediator IEventHandler of InvitationRedeemed", "Policy 2.2: the only path into a care link; establishes it")
    Component(onWithdrawn, "OnConsentWithdrawnHandler", "Cortex.Mediator IEventHandler of ConsentWithdrawn", "Policy 2.5: withdrawal revokes the link")
    Component(onTargetsUpdated, "OnActiveTargetsUpdatedCareRelationshipHandler", "Cortex.Mediator IEventHandler of ActiveTargetsUpdated", "Marks the new targets as pending acknowledgement")
    Component(onAiConsentHandler, "OnAiProcessingConsentChangedHandler", "Cortex.Mediator IEventHandler of AiProcessingConsentChanged", "Syncs the AI preferences and purges the generations when consent is withdrawn")
    Component(onAiPrefsHandler, "OnAiPreferencesChangedHandler", "Cortex.Mediator IEventHandler of AiPreferencesChanged", "Purges the generations of the AI functions turned off")

    Component(crFacade, "CareRelationshipContextFacade", "C# ACL - Open Host Service (ICareRelationshipContextFacade)", "Publishes the active link authorisation, the consent and the link history")
    Component(aiConsentPolicy, "CareRelationshipAiConsentPolicy", "C# ACL (IAiConsentPolicy)", "Answers whether an AI function is allowed for a patient")

    Component(expiryHostedService, "InvitationExpiryHostedService", "ASP.NET Core BackgroundService", "Sweeps and expires stale invitations")

    Component(careLinkAggregate, "CareLink", "C# Aggregate Root", "Guards consent, AI consent, revocation and discharge")
    Component(invitationAggregate, "Invitation", "C# Aggregate Root", "Single-use token with an expiry")
    Component(aiPrefsAggregate, "AiPreferences", "C# Aggregate Root", "Which AI functions the patient allows")
    Component(crValueObjects, "Value Objects and Errors", "C# records and enums", "InvitationToken, Consent, ClinicalReason, errors")

    Component(crRepos, "CareLink, Invitation and AiPreferences Repositories", "C# Repositories over EF Core 10", "Persist care links, invitations and AI preferences")
    Component(crEfcConfig, "Care Relationship EntityTypeConfigurations", "EF Core 10 Fluent API", "Maps tables, token index and audit")
}

ContainerDb(db, "Healthify Database", "MySQL 8.4", "Owns the care_links, invitations, ai_preferences and audit tables of this context")

Container_Ext(iamCtx, "IAM", "Sibling bounded context", "Consulted through IIamContextFacade to confirm the two parties exist and hold the expected roles")
Container_Ext(nutritionalCareCtx, "Nutritional Care", "Sibling bounded context", "Publishes ActiveTargetsUpdated; asks the Open Host Service whether the link is active")
Container_Ext(intakeCtx, "Intake and Body Response", "Sibling bounded context", "Asks the Open Host Service and the consent policy; subscribes to AiProcessingConsentChanged and AiPreferencesChanged")
Container_Ext(monitoringCtx, "Monitoring and Adherence", "Sibling bounded context", "Asks the Open Host Service and the consent policy; subscribes to CareLinkEstablished, CareLinkRevoked, TreatmentDischarged, AiProcessingConsentChanged and AiPreferencesChanged")
Container_Ext(readModelsCtx, "Read Models", "Composition layer (not a bounded context)", "Asks the Open Host Service before composing patient data")
Container_Ext(aiModule, "AI module (Shared)", "Technical module", "Generation pipeline that asks the consent policy; keeps the audit log of generations (IAiGenerationLog)")

Rel(practitioner, mobile, "Issues invitations, discharges patients and reads the roster", "Touch")
Rel(patient, mobile, "Redeems the invitation, grants or withdraws consent and sets the AI preferences", "Touch")
Rel(mobile, invitationsController, "Issues and redeems invitations", "JSON/HTTPS, Bearer JWT")
Rel(mobile, careLinksController, "Grants consent, acknowledges targets, revokes and discharges", "JSON/HTTPS, Bearer JWT")
Rel(mobile, patientCareLinksController, "Reads the active link and the history", "JSON/HTTPS, Bearer JWT")
Rel(mobile, practitionerPatientsController, "Reads the linked patients", "JSON/HTTPS, Bearer JWT")
Rel(mobile, aiPrefsController, "Reads and changes the AI preferences", "JSON/HTTPS, Bearer JWT")

Rel(invitationsController, crAssemblers, "Maps resources and commands through", "in-process")
Rel(careLinksController, crAssemblers, "Maps resources and commands through", "in-process")
Rel(patientCareLinksController, crAssemblers, "Maps aggregates to resources through", "in-process")
Rel(practitionerPatientsController, crAssemblers, "Maps aggregates to resources through", "in-process")
Rel(aiPrefsController, crAssemblers, "Maps resources and commands through", "in-process")

Rel(invitationsController, invitationCmdService, "Sends invitation commands", "in-process")
Rel(invitationsController, invitationQryService, "Sends invitation queries", "in-process")
Rel(careLinksController, careLinkCmdService, "Sends care link commands", "in-process")
Rel(careLinksController, careLinkQryService, "Sends care link queries", "in-process")
Rel(patientCareLinksController, careLinkQryService, "Sends care link queries", "in-process")
Rel(practitionerPatientsController, careLinkQryService, "Sends roster queries", "in-process")
Rel(aiPrefsController, aiPrefsCmdService, "Sends AI preference commands", "in-process")
Rel(aiPrefsController, aiPrefsQryService, "Sends AI preference queries", "in-process")

Rel(invitationCmdService, invitationAggregate, "Issues, redeems and expires", "in-process")
Rel(careLinkCmdService, careLinkAggregate, "Establishes, consents, revokes and discharges", "in-process")
Rel(aiPrefsCmdService, aiPrefsAggregate, "Changes, enables and disables", "in-process")
Rel(careLinkAggregate, crValueObjects, "Is built from", "in-process")
Rel(invitationAggregate, crValueObjects, "Is built from", "in-process")

Rel(invitationCmdService, onRedeemed, "Publishes InvitationRedeemed to", "Cortex.Mediator, in-process")
Rel(onRedeemed, careLinkCmdService, "Sends EstablishCareLinkCommand", "in-process, own DI scope")
Rel(careLinkCmdService, onWithdrawn, "Publishes ConsentWithdrawn to", "Cortex.Mediator, in-process")
Rel(onWithdrawn, careLinkCmdService, "Sends RevokeCareLinkCommand", "in-process, own DI scope")
Rel(nutritionalCareCtx, onTargetsUpdated, "Publishes ActiveTargetsUpdated", "Cortex.Mediator, in-process")
Rel(onTargetsUpdated, careLinkCmdService, "Sends MarkTargetsPendingAcknowledgementCommand", "in-process, own DI scope")
Rel(careLinkCmdService, onAiConsentHandler, "Publishes AiProcessingConsentChanged to", "Cortex.Mediator, in-process")
Rel(invitationCmdService, onAiConsentHandler, "Publishes AiProcessingConsentChanged to", "Cortex.Mediator, in-process")
Rel(onAiConsentHandler, aiPrefsCmdService, "Sends SyncAiPreferencesWithConsentCommand", "in-process, own DI scope")
Rel(onAiConsentHandler, aiModule, "Purges the generations of the patient", "in-process")
Rel(aiPrefsCmdService, onAiPrefsHandler, "Publishes AiPreferencesChanged to", "Cortex.Mediator, in-process")
Rel(onAiPrefsHandler, aiModule, "Purges the generations of the functions turned off", "in-process")
Rel(expiryHostedService, invitationQryService, "Lists the stale invitations through", "in-process, periodic")
Rel(expiryHostedService, invitationCmdService, "Sends ExpireInvitationCommand", "in-process, periodic")

Rel(careLinkCmdService, monitoringCtx, "Publishes CareLinkEstablished, CareLinkRevoked and TreatmentDischarged", "Cortex.Mediator, in-process")
Rel(careLinkCmdService, intakeCtx, "Publishes AiProcessingConsentChanged", "Cortex.Mediator, in-process")
Rel(aiPrefsCmdService, intakeCtx, "Publishes AiPreferencesChanged", "Cortex.Mediator, in-process")
Rel(aiPrefsCmdService, monitoringCtx, "Publishes AiPreferencesChanged", "Cortex.Mediator, in-process")

Rel(invitationCmdService, crRepos, "Reads and writes through", "in-process")
Rel(careLinkCmdService, crRepos, "Reads and writes through", "in-process")
Rel(aiPrefsCmdService, crRepos, "Reads and writes through", "in-process")
Rel(invitationQryService, crRepos, "Reads through", "in-process")
Rel(careLinkQryService, crRepos, "Reads through", "in-process")
Rel(aiPrefsQryService, crRepos, "Reads through", "in-process")
Rel(crRepos, crEfcConfig, "Is mapped by", "EF Core model")
Rel(crRepos, db, "Reads from and writes to", "EF Core 10 / MySQL, TCP 3306")

Rel(crFacade, careLinkQryService, "Resolves links and consent through", "in-process")
Rel(aiConsentPolicy, aiPrefsQryService, "Resolves the preferences through", "in-process")
Rel(nutritionalCareCtx, crFacade, "Asks whether the link is active", "in-process ACL call")
Rel(intakeCtx, crFacade, "Asks whether the link is active", "in-process ACL call")
Rel(monitoringCtx, crFacade, "Asks whether the link is active", "in-process ACL call")
Rel(readModelsCtx, crFacade, "Asks whether the link is active", "in-process ACL call")
Rel(aiModule, aiConsentPolicy, "Asks whether the AI function is allowed", "in-process ACL call")
Rel(intakeCtx, aiConsentPolicy, "Asks whether the AI function is allowed", "in-process ACL call")
Rel(monitoringCtx, aiConsentPolicy, "Asks whether the AI function is allowed", "in-process ACL call")
Rel(careLinkCmdService, iamCtx, "Confirms the two parties and their roles", "in-process ACL call")
Rel(invitationCmdService, iamCtx, "Confirms the two parties and their roles", "in-process ACL call")

@enduml
