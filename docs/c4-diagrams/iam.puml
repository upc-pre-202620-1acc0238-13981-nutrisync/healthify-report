@startuml IAM_Component_Diagram
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_TOP_DOWN()
LAYOUT_WITH_LEGEND()

title Component Diagram - Bounded Context "IAM" (Container: Healthify Platform API)

Person(patient, "Patient", "Registers, signs in, recovers the password and keeps a session on the mobile navigation shell")
Person(practitioner, "Practitioner", "Registers, signs in, recovers the password and keeps a session on the clinical navigation shell")

Container(mobile, "Mobile Application", "Flutter / MAUI", "Two navigation shells selected by the role claim carried in the issued token")

Container_Boundary(api, "Healthify Platform API") {

    Component(authController, "AuthenticationController", "ASP.NET Core REST Controller", "api/v1/authentication. Sign up, sign in, token refresh, password reset and sign out")
    Component(sessionsController, "SessionsController", "ASP.NET Core REST Controller", "api/v1/sessions. Navigation shell of a session")
    Component(usersController, "UsersController", "ASP.NET Core REST Controller", "api/v1/users. Reads a user, changes the preferred language, lists sessions")
    Component(iamAssemblers, "IAM Transform Assemblers", "C# static assemblers", "Maps resources, commands and responses")

    Component(userCmdService, "UserCommandService", "C# Application Service (CQRS command side)", "Registers accounts and changes the preferred language")
    Component(sessionCmdService, "UserSessionCommandService", "C# Application Service (CQRS command side)", "Signs in, refreshes, signs out and selects the navigation shell")
    Component(passwordResetCmdService, "PasswordResetCommandService", "C# Application Service (CQRS command side)", "Requests, verifies and applies the password reset")
    Component(userQryService, "UserQueryService", "C# Application Service (CQRS query side)", "Reads users by id or e-mail")
    Component(sessionQryService, "UserSessionQueryService", "C# Application Service (CQRS query side)", "Reads sessions of a user")

    Component(roleClaimHandler, "OnRoleClaimIssuedHandler", "Cortex.Mediator IEventHandler of RoleClaimIssued", "Policy 1.2: mounts the navigation shell")
    Component(iamFacade, "IamContextFacade", "C# ACL - Open Host Service (IIamContextFacade)", "Publishes identity, role and preferred-language questions")

    Component(userAggregate, "User", "C# Aggregate Root", "Guards identity, credentials and lockout")
    Component(sessionAggregate, "UserSession", "C# Aggregate Root", "Guards session and refresh-token invariants")
    Component(resetCodeAggregate, "PasswordResetCode", "C# Aggregate Root", "Single-use reset code with expiry and failed attempts")
    Component(valueObjects, "Value Objects and Errors", "C# records and enums", "Email, Password, Role, NavigationShell, PreferredLanguage, IamError")

    Component(bcrypt, "BCryptHashingService", "C# adapter (IHashingService), BCrypt.Net-Next 4.0.3", "Hashes and verifies passwords")
    Component(jwt, "JwtTokenService", "C# adapter (ITokenService), JwtBearer 10", "Issues the bearer token")
    Component(refreshTokenService, "RefreshTokenService", "C# infrastructure service (IRefreshTokenService)", "Issues and rotates the refresh token and detects reuse")
    Component(resetCodeService, "PasswordResetCodeService", "C# infrastructure service (IPasswordResetCodeService)", "Issues and matches the reset code and the reset token")
    Component(lockoutPolicy, "ConfiguredSignInLockoutPolicy", "C# infrastructure service (ISignInLockoutPolicy)", "Lockout duration after the failed attempts")
    Component(smtpEmail, "SmtpEmailService", "C# adapter (IEmailService)", "Sends the password reset code by e-mail")
    Component(languageProvider, "LanguageClaimRequestCultureProvider", "ASP.NET Core localization", "Takes the language of the response from the token")

    Component(iamRepos, "IAM Repositories", "C# Repositories over EF Core 10", "User, UserSession and PasswordResetCode repositories")
    Component(efcConfig, "IAM EntityTypeConfigurations", "EF Core 10 Fluent API", "Maps tables, columns and unique indexes")
}

ContainerDb(db, "Healthify Database", "MySQL 8.4", "Single schema, one migration per bounded context. IAM owns users, user_sessions and password reset codes")

Container_Ext(careRelCtx, "Care Relationship", "Sibling bounded context", "Asks the Open Host Service to confirm the two parties of a link")
Container_Ext(nutritionalCareCtx, "Nutritional Care", "Sibling bounded context", "Asks the Open Host Service to confirm the practitioner and read the preferred language")
Container_Ext(monitoringCtx, "Monitoring and Adherence", "Sibling bounded context", "Asks the Open Host Service for names and the preferred language")
Container_Ext(intakeCtx, "Intake and Body Response", "Sibling bounded context", "Asks the Open Host Service for the preferred language of the patient")
Container_Ext(readModelsCtx, "Read Models", "Composition layer (not a bounded context)", "Asks the Open Host Service for the names it composes")
System_Ext(smtp, "SMTP server", "E-mail provider", "Delivers the password reset code")

Rel(patient, mobile, "Registers, signs in and recovers the password", "Touch")
Rel(practitioner, mobile, "Registers, signs in and recovers the password", "Touch")
Rel(mobile, authController, "Registers, signs in, refreshes the token, resets the password and signs out", "JSON/HTTPS, Bearer JWT")
Rel(mobile, sessionsController, "Reads the navigation shell", "JSON/HTTPS, Bearer JWT")
Rel(mobile, usersController, "Reads the user and changes the language", "JSON/HTTPS, Bearer JWT")

Rel(authController, iamAssemblers, "Maps resources and commands through", "in-process")
Rel(sessionsController, iamAssemblers, "Maps aggregates to resources through", "in-process")
Rel(usersController, iamAssemblers, "Maps resources and commands through", "in-process")

Rel(authController, userCmdService, "Sends RegisterAccountCommand", "in-process")
Rel(authController, sessionCmdService, "Sends SignIn, RefreshSession and SignOut commands", "in-process")
Rel(authController, passwordResetCmdService, "Sends the password reset commands", "in-process")
Rel(sessionsController, sessionQryService, "Sends session queries", "in-process")
Rel(usersController, userCmdService, "Sends ChangePreferredLanguageCommand", "in-process")
Rel(usersController, userQryService, "Sends user queries", "in-process")
Rel(usersController, sessionQryService, "Sends session queries", "in-process")

Rel(userCmdService, userAggregate, "Registers and changes the language of", "in-process")
Rel(sessionCmdService, userAggregate, "Verifies the credentials and applies the lockout of", "in-process")
Rel(sessionCmdService, sessionAggregate, "Opens, refreshes, terminates and shells", "in-process")
Rel(passwordResetCmdService, userAggregate, "Changes the password of", "in-process")
Rel(passwordResetCmdService, resetCodeAggregate, "Issues, verifies and consumes", "in-process")
Rel(userAggregate, valueObjects, "Is built from", "in-process")
Rel(sessionAggregate, valueObjects, "Is built from", "in-process")

Rel(sessionCmdService, roleClaimHandler, "Publishes RoleClaimIssued to", "Cortex.Mediator, in-process")
Rel(roleClaimHandler, sessionCmdService, "Sends SelectNavigationShellCommand", "in-process, own DI scope")

Rel(userCmdService, bcrypt, "Hashes the password with", "in-process")
Rel(sessionCmdService, bcrypt, "Verifies the password with", "in-process")
Rel(passwordResetCmdService, bcrypt, "Hashes the new password with", "in-process")
Rel(sessionCmdService, jwt, "Issues the bearer token with", "in-process")
Rel(sessionCmdService, refreshTokenService, "Issues and rotates the refresh token with", "in-process")
Rel(sessionCmdService, lockoutPolicy, "Reads the lockout duration from", "in-process")
Rel(passwordResetCmdService, resetCodeService, "Issues and matches the code with", "in-process")
Rel(passwordResetCmdService, smtpEmail, "Sends the code through", "in-process")
Rel(smtpEmail, smtp, "Sends the e-mail to", "SMTP")
Rel(languageProvider, jwt, "Reads the language claim of the token issued by", "ASP.NET Core pipeline")

Rel(userCmdService, iamRepos, "Reads and writes through", "in-process")
Rel(sessionCmdService, iamRepos, "Reads and writes through", "in-process")
Rel(passwordResetCmdService, iamRepos, "Reads and writes through", "in-process")
Rel(userQryService, iamRepos, "Reads through", "in-process")
Rel(sessionQryService, iamRepos, "Reads through", "in-process")
Rel(iamRepos, efcConfig, "Is mapped by", "EF Core model")
Rel(iamRepos, db, "Reads from and writes to", "EF Core 10 / MySQL, TCP 3306")

Rel(iamFacade, userQryService, "Resolves identities through", "in-process")
Rel(careRelCtx, iamFacade, "Confirms the two parties and their roles", "in-process ACL call")
Rel(nutritionalCareCtx, iamFacade, "Confirms the practitioner and reads the preferred language", "in-process ACL call")
Rel(monitoringCtx, iamFacade, "Reads names and the preferred language", "in-process ACL call")
Rel(intakeCtx, iamFacade, "Reads the preferred language", "in-process ACL call")
Rel(readModelsCtx, iamFacade, "Reads the names it composes", "in-process ACL call")

@enduml
