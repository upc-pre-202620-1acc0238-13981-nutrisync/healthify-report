@startuml IntakeBodyResponse_Component_Diagram
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_TOP_DOWN()
LAYOUT_WITH_LEGEND()

title Component Diagram - Bounded Context "Intake and Body Response" (Container: Healthify Platform API)

Person(patient, "Patient", "Logs meals, confirms the portion estimate and records self weigh-ins between consultations")
Person(practitioner, "Practitioner", "Reads the diary and the weight trend of a linked patient through Monitoring and Read Models; never writes here")

Container(mobile, "Mobile Application", "Flutter / MAUI", "Offline-first diary. Uploads the photo for server-side recognition and synchronises the entries when connectivity returns; ML Kit only reads the invitation QR")

Container_Boundary(api, "Healthify Platform API") {

    Component(diaryController, "DiaryEntriesController", "ASP.NET Core REST Controller", "api/v1/diary-entries. Log and synchronise; reads entries")
    Component(weighInsController, "SelfWeighInsController", "ASP.NET Core REST Controller", "api/v1/self-weigh-ins. Record and synchronise weigh-ins")
    Component(patientIntakeController, "PatientIntakeController", "ASP.NET Core REST Controller", "api/v1/patients. Targets, diary, trend, plan fit and daily intake")
    Component(mealPhotoController, "PatientMealPhotoAnalysesController", "ASP.NET Core REST Controller", "api/v1/patients/{id}/meal-photo-analyses. Recognizes a meal from a photo")
    Component(mealIdeasController, "PatientMealIdeasController", "ASP.NET Core REST Controller", "api/v1/patients/{id}/meal-ideas. Suggests meals that fit what is left of the day")
    Component(intakeAssemblers, "Intake Transform Assemblers", "C# static assemblers", "Maps resources, commands and responses")

    Component(diaryCmdService, "DiaryEntryCommandService", "C# Application Service (CQRS command side)", "Logs, estimates, confirms, adjusts and synchronises entries")
    Component(weighInCmdService, "SelfWeighInCommandService", "C# Application Service (CQRS command side)", "Records and synchronises self weigh-ins")
    Component(trendCmdService, "WeightTrendCommandService", "C# Application Service (CQRS command side)", "Recalculates the smoothed weight trend")
    Component(targetsCacheCmdService, "ActiveTargetsCacheCommandService", "C# Application Service (CQRS command side)", "Refreshes the local targets copy")
    Component(mealPhotoCmdService, "MealPhotoAnalysisCommandService", "C# Application Service (CQRS command side)", "Strips the metadata, calls the AI module, proposes an estimate and purges analyses")
    Component(mealIdeasCmdService, "MealIdeasCommandService", "C# Application Service (CQRS command side)", "Generates meal ideas from the remaining targets and the restrictions; purges the cached ideas")

    Component(diaryQryService, "DiaryEntryQueryService", "C# Application Service (CQRS query side)", "Reads diary entries, ranges and the pending sync queue")
    Component(dailyIntakeQryService, "DailyIntakeQueryService", "C# Application Service (CQRS query side)", "Daily intake against the targets")
    Component(planFitQryService, "PlanFitQueryService", "C# Application Service (CQRS query side)", "How a food fits the plan and the restrictions")
    Component(targetsQryService, "ActiveTargetsCacheQueryService", "C# Application Service (CQRS query side)", "Reads the cached targets")
    Component(trendQryService, "WeightTrendQueryService", "C# Application Service (CQRS query side)", "Reads the weight trend and its ranges")
    Component(weighInQryService, "SelfWeighInQueryService", "C# Application Service (CQRS query side)", "Reads the weigh-ins and the patients that have any")

    Component(onTargetsUpdated, "OnActiveTargetsUpdatedIntakeHandler", "Cortex.Mediator IEventHandler of ActiveTargetsUpdated", "Policy 4.1: caches the published targets")
    Component(onPhotoEstimation, "OnMealLoggedPhotoEstimationHandler", "Cortex.Mediator IEventHandler of MealLogged", "Policy 4.2: stores the proposal supplied by the client (legacy path)")
    Component(onWeighIn, "OnSelfWeighInRecordedHandler", "Cortex.Mediator IEventHandler of SelfWeighInRecorded", "Policy 4.5: recalculates the trend (skips readings of a sync batch)")
    Component(onWeighInBatch, "OnSelfWeighInBatchSynchronizedHandler", "Cortex.Mediator IEventHandler of SelfWeighInBatchSynchronized", "Recalculates the trend once per synchronised batch")
    Component(onAiConsent, "OnAiProcessingConsentChangedIntakeHandler", "Cortex.Mediator IEventHandler of AiProcessingConsentChanged", "Purges photo analyses and meal ideas when consent is withdrawn")
    Component(onAiPrefs, "OnAiPreferencesChangedIntakeHandler", "Cortex.Mediator IEventHandler of AiPreferencesChanged", "Purges meal ideas or photo analyses when their AI switch goes off")

    Component(intakeFacade, "IntakeContextFacade", "C# ACL - Open Host Service (IIntakeContextFacade)", "Publishes daily summaries, diary entries and the weight trend to other contexts")

    Component(photoPurgeService, "MealPhotoAnalysisPurgeHostedService", "ASP.NET Core BackgroundService", "Deletes expired photo analyses")
    Component(trendJob, "WeightTrendRecalculationJob", "C# one-shot job (CLI verb recalculate-weight-trends)", "Rebuilds every patient's trend; never runs at start-up and has no endpoint")
    Component(metadataStripper, "PhotoMetadataStripper", "C# infrastructure service", "Removes EXIF, XMP and ICC data before the photo reaches the AI")
    Component(protocolProvider, "ConfiguredSelfWeighInProtocolProvider", "C# infrastructure service", "Weigh-in protocol read from configuration")
    Component(ideasCache, "InMemoryMealIdeasCache", "C# in-memory cache", "Keeps the generated ideas for two hours")
    Component(nameHintsCache, "InMemoryCatalogNameHintsCache", "C# in-memory cache", "Catalog food names offered to the model as hints")
    Component(restrictionLexicon, "EmbeddedRestrictionLexicon", "C# embedded lexicon", "Maps restrictions to foods that break them")

    Component(diaryAggregate, "DiaryEntry", "C# Aggregate Root", "A meal with provenance and estimate")
    Component(weighInAggregate, "SelfWeighIn", "C# Aggregate Root", "Weight measured by the patient")
    Component(trendAggregate, "WeightTrend", "C# Aggregate Root", "Smoothed series of the weigh-ins")
    Component(targetsCacheAggregate, "ActiveTargetsCache", "C# Aggregate Root", "Read-only copy of the published targets")
    Component(photoAnalysisAggregate, "MealPhotoAnalysis", "C# Aggregate Root", "Temporary result of a photo analysis; the photo itself is never stored")
    Component(intakeValueObjects, "Value Objects and Errors", "C# records and enums", "Estimates, Provenance, LocalTimestamp, errors")

    Component(intakeRepos, "Intake Repositories", "C# Repositories over EF Core 10", "DiaryEntry, SelfWeighIn, WeightTrend, ActiveTargetsCache and MealPhotoAnalysis repositories")
    Component(intakeEfcConfig, "Intake EntityTypeConfigurations", "EF Core 10 Fluent API", "Maps tables, sync index and audit")
}

ContainerDb(db, "Healthify Database", "MySQL 8.4", "Owns diary_entries, self_weigh_ins, weight_trends, active_targets_caches and meal_photo_analyses")

Container_Ext(careRelCtx, "Care Relationship", "Sibling bounded context", "Consulted through ICareRelationshipContextFacade; publishes AiProcessingConsentChanged and AiPreferencesChanged")
Container_Ext(foodCatalogCtx, "Food Catalog", "Sibling bounded context", "Consulted through IFoodCatalogContextFacade to resolve foods against the local catalog")
Container_Ext(iamCtx, "IAM", "Sibling bounded context", "Consulted through IIamContextFacade for the preferred language")
Container_Ext(nutritionalCareCtx, "Nutritional Care", "Sibling bounded context", "Publishes ActiveTargetsUpdated; reads the intake summaries through the Open Host Service")
Container_Ext(monitoringCtx, "Monitoring and Adherence", "Sibling bounded context", "Subscribes to MealLogged, MealGroupLogged, EstimateConfirmedByPatient, OffPlanEntryLogged, EntrySynchronized, DiaryBatchSynchronized and WeightTrendRecalculated; reads the intake summaries through the Open Host Service")
Container_Ext(readModels, "Read Models", "Composition layer (not a bounded context)", "Composes patient summary, record, monitoring panel and data export from the Open Host Service")

Container_Ext(aiModule, "AI module (Shared)", "Technical module", "Generation pipeline behind consent, validation and quota controls; switched off by default")
System_Ext(gemini, "Gemini API", "Google generative model", "Recognizes the meal and writes the ideas")

Rel(patient, mobile, "Logs meals, confirms estimates and weighs in", "Touch, works offline")
Rel(practitioner, readModels, "Reads the diary and the trend through", "Mobile app, JSON/HTTPS")
Rel(mobile, diaryController, "Logs, synchronises and reads diary entries", "JSON/HTTPS, Bearer JWT")
Rel(mobile, weighInsController, "Records and synchronises self weigh-ins", "JSON/HTTPS, Bearer JWT")
Rel(mobile, patientIntakeController, "Reads targets, daily summary, diary and trend", "JSON/HTTPS, Bearer JWT")
Rel(mobile, mealPhotoController, "Uploads the photo and reads the proposed estimate", "JSON/HTTPS, Bearer JWT")
Rel(mobile, mealIdeasController, "Asks for meal ideas", "JSON/HTTPS, Bearer JWT")

Rel(diaryController, intakeAssemblers, "Maps resources and commands through", "in-process")
Rel(weighInsController, intakeAssemblers, "Maps resources and commands through", "in-process")
Rel(patientIntakeController, intakeAssemblers, "Maps aggregates to resources through", "in-process")
Rel(mealPhotoController, intakeAssemblers, "Maps resources and commands through", "in-process")
Rel(mealIdeasController, intakeAssemblers, "Maps resources and commands through", "in-process")

Rel(diaryController, diaryCmdService, "Sends diary commands", "in-process")
Rel(diaryController, diaryQryService, "Sends diary queries", "in-process")
Rel(weighInsController, weighInCmdService, "Sends RecordSelfWeighInCommand and SyncSelfWeighInsCommand", "in-process")
Rel(weighInsController, protocolProvider, "Reads the weigh-in protocol from", "in-process")
Rel(patientIntakeController, targetsQryService, "Reads the cached targets through", "in-process")
Rel(patientIntakeController, diaryQryService, "Reads the diary through", "in-process")
Rel(patientIntakeController, trendQryService, "Reads the weight trend through", "in-process")
Rel(patientIntakeController, planFitQryService, "Reads the plan fit through", "in-process")
Rel(patientIntakeController, dailyIntakeQryService, "Reads the daily intake through", "in-process")
Rel(mealPhotoController, mealPhotoCmdService, "Sends AnalyzeMealPhotoCommand", "in-process")
Rel(mealIdeasController, mealIdeasCmdService, "Sends GenerateMealIdeasCommand", "in-process")

Rel(diaryCmdService, diaryAggregate, "Logs, estimates, confirms and synchronises", "in-process")
Rel(weighInCmdService, weighInAggregate, "Records", "in-process")
Rel(trendCmdService, trendAggregate, "Rebuilds from the weigh-ins", "in-process")
Rel(targetsCacheCmdService, targetsCacheAggregate, "Refreshes", "in-process")
Rel(mealPhotoCmdService, photoAnalysisAggregate, "Records the analysis in", "in-process")
Rel(diaryAggregate, intakeValueObjects, "Is built from", "in-process")
Rel(weighInAggregate, intakeValueObjects, "Is built from", "in-process")

Rel(nutritionalCareCtx, onTargetsUpdated, "Publishes ActiveTargetsUpdated", "Cortex.Mediator, in-process")
Rel(onTargetsUpdated, targetsCacheCmdService, "Sends RefreshActiveTargetsCacheCommand", "in-process, own DI scope")
Rel(diaryCmdService, onPhotoEstimation, "Publishes MealLogged to", "Cortex.Mediator, in-process")
Rel(onPhotoEstimation, diaryCmdService, "Sends EstimatePortionCommand with the client proposal", "in-process, own DI scope")
Rel(weighInCmdService, onWeighIn, "Publishes SelfWeighInRecorded to", "Cortex.Mediator, in-process")
Rel(weighInCmdService, onWeighInBatch, "Publishes SelfWeighInBatchSynchronized to", "Cortex.Mediator, in-process")
Rel(onWeighIn, trendCmdService, "Sends RecalculateWeightTrendCommand", "in-process, own DI scope")
Rel(onWeighInBatch, trendCmdService, "Sends RecalculateWeightTrendCommand once per batch", "in-process, own DI scope")
Rel(careRelCtx, onAiConsent, "Publishes AiProcessingConsentChanged", "Cortex.Mediator, in-process")
Rel(careRelCtx, onAiPrefs, "Publishes AiPreferencesChanged", "Cortex.Mediator, in-process")
Rel(onAiConsent, mealPhotoCmdService, "Sends PurgeMealPhotoAnalysesCommand", "in-process, own DI scope")
Rel(onAiConsent, mealIdeasCmdService, "Sends PurgeMealIdeasCommand", "in-process, own DI scope")
Rel(onAiPrefs, mealPhotoCmdService, "Sends PurgeMealPhotoAnalysesCommand", "in-process, own DI scope")
Rel(onAiPrefs, mealIdeasCmdService, "Sends PurgeMealIdeasCommand", "in-process, own DI scope")
Rel(photoPurgeService, mealPhotoCmdService, "Sends PurgeExpiredMealPhotoAnalysesCommand", "in-process, periodic")
Rel(trendJob, weighInQryService, "Lists the patients with weigh-ins through", "in-process, CLI run")
Rel(trendJob, trendCmdService, "Sends RecalculateWeightTrendCommand per patient", "in-process, CLI run")

Rel(weighInCmdService, protocolProvider, "Reads the weigh-in protocol from", "in-process")
Rel(trendCmdService, protocolProvider, "Reads the weigh-in protocol from", "in-process")
Rel(trendQryService, protocolProvider, "Reads the weigh-in protocol from", "in-process")
Rel(mealPhotoCmdService, metadataStripper, "Cleans the photo through", "in-process")
Rel(mealPhotoCmdService, planFitQryService, "Checks the fit of the recognized food through", "in-process")
Rel(mealPhotoCmdService, nameHintsCache, "Reads the catalog name hints from", "in-process")
Rel(mealIdeasCmdService, nameHintsCache, "Reads the catalog name hints from", "in-process")
Rel(mealIdeasCmdService, ideasCache, "Stores and evicts the ideas in", "in-process")
Rel(mealIdeasCmdService, restrictionLexicon, "Filters the ideas with", "in-process")
Rel(planFitQryService, restrictionLexicon, "Checks the restrictions with", "in-process")

Rel(diaryCmdService, intakeRepos, "Reads and writes through", "in-process")
Rel(weighInCmdService, intakeRepos, "Reads and writes through", "in-process")
Rel(trendCmdService, intakeRepos, "Reads and writes through", "in-process")
Rel(targetsCacheCmdService, intakeRepos, "Reads and writes through", "in-process")
Rel(mealPhotoCmdService, intakeRepos, "Reads and writes through", "in-process")
Rel(mealIdeasCmdService, intakeRepos, "Reads the targets and the diary through", "in-process")
Rel(diaryQryService, intakeRepos, "Reads through", "in-process")
Rel(dailyIntakeQryService, intakeRepos, "Reads through", "in-process")
Rel(planFitQryService, intakeRepos, "Reads through", "in-process")
Rel(targetsQryService, intakeRepos, "Reads through", "in-process")
Rel(trendQryService, intakeRepos, "Reads through", "in-process")
Rel(weighInQryService, intakeRepos, "Reads through", "in-process")
Rel(intakeRepos, intakeEfcConfig, "Is mapped by", "EF Core model")
Rel(intakeRepos, db, "Reads from and writes to", "EF Core 10 / MySQL, TCP 3306")

Rel(intakeFacade, diaryQryService, "Resolves diary summaries through", "in-process")
Rel(intakeFacade, trendQryService, "Resolves trend points through", "in-process")
Rel(intakeFacade, weighInQryService, "Resolves weigh-in exports through", "in-process")
Rel(intakeFacade, protocolProvider, "Reads the weigh-in protocol from", "in-process")
Rel(monitoringCtx, intakeFacade, "Reads the daily summary and the weight trend", "in-process ACL call")
Rel(nutritionalCareCtx, intakeFacade, "Reads the intake and trend inputs of a plan adjustment", "in-process ACL call")
Rel(readModels, intakeFacade, "Reads diary, trend and export data", "in-process ACL call")

Rel(targetsCacheCmdService, careRelCtx, "Confirms the care link is active", "in-process ACL call")
Rel(diaryCmdService, foodCatalogCtx, "Resolves the food of the entry", "in-process ACL call")
Rel(diaryQryService, foodCatalogCtx, "Resolves food names", "in-process ACL call")
Rel(dailyIntakeQryService, foodCatalogCtx, "Resolves nutrients", "in-process ACL call")
Rel(planFitQryService, foodCatalogCtx, "Resolves nutrients", "in-process ACL call")
Rel(intakeFacade, foodCatalogCtx, "Resolves nutrients for the summaries", "in-process ACL call")
Rel(mealPhotoCmdService, foodCatalogCtx, "Resolves or creates the recognized food", "in-process ACL call")
Rel(mealIdeasCmdService, foodCatalogCtx, "Resolves the ingredient names", "in-process ACL call")
Rel(mealIdeasCmdService, iamCtx, "Reads the preferred language", "in-process ACL call")
Rel(diaryCmdService, monitoringCtx, "Publishes MealLogged, MealGroupLogged, EstimateConfirmedByPatient, OffPlanEntryLogged, EntrySynchronized and DiaryBatchSynchronized", "Cortex.Mediator, in-process")
Rel(trendCmdService, monitoringCtx, "Publishes WeightTrendRecalculated", "Cortex.Mediator, in-process")

Rel(mealPhotoCmdService, aiModule, "Recognizes the meal through", "in-process, own pipeline")
Rel(mealIdeasCmdService, aiModule, "Generates the ideas through", "in-process, own pipeline")
Rel(aiModule, gemini, "Sends the prompt and the cleaned photo to", "JSON/HTTPS")

@enduml
