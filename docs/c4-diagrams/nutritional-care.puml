@startuml NutritionalCare_Component_Diagram
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_TOP_DOWN()
LAYOUT_WITH_LEGEND()

title Component Diagram - Bounded Context "Nutritional Care" (Container: Healthify Platform API)

Person(practitioner, "Practitioner", "The only actor who may assess, diagnose, prescribe targets and resolve a review item")
Person(patient, "Patient", "Receives only the reduced published contract: targets, guidelines and restrictions")

Container(mobile, "Mobile Application", "Flutter / MAUI", "Clinical navigation shell for the practitioner; the patient shell renders only the published targets")

Container_Boundary(api, "Healthify Platform API") {

    Component(consultationsController, "ConsultationsController", "ASP.NET Core REST Controller", "api/v1/consultations. Steps of the consultation and AI suggestions")
    Component(patientConsultationsController, "PatientConsultationsController", "ASP.NET Core REST Controller", "api/v1/patients. Start, read and abandon the consultation of a patient")
    Component(plansController, "NutritionPlansController", "ASP.NET Core REST Controller", "api/v1/nutrition-plans. Publish active targets and adjust the plan")
    Component(planVersionsController, "PatientPlanVersionsController", "ASP.NET Core REST Controller", "api/v1/patients. Published plan versions seen by the patient")
    Component(clinicalRecordController, "PatientClinicalRecordController", "ASP.NET Core REST Controller", "api/v1/patients. Read-only clinical record: assessments, active diagnosis and plans")
    Component(assessmentsController, "NutritionalAssessmentsController", "ASP.NET Core REST Controller", "api/v1/nutritional-assessments. Read an assessment")
    Component(baselineController, "PatientBaselineController", "ASP.NET Core REST Controller", "api/v1/patients. Record, update and read the baseline")
    Component(reviewItemsController, "ReviewItemsController", "ASP.NET Core REST Controller", "api/v1/review-items. Plan proposal, acceptance and resolution")
    Component(ncAssemblers, "Nutritional Care Transform Assemblers", "C# static assemblers", "Maps resources, commands and responses")

    Component(consultationCmdService, "ConsultationCommandService", "C# Application Service (CQRS command side)", "Runs the consultation: measurement, diagnosis, targets, publication and abandonment")
    Component(consultationAiCmdService, "ConsultationAiCommandService", "C# Application Service (CQRS command side)", "Suggests the diagnosis and the guidelines through the AI module")
    Component(planCmdService, "NutritionPlanCommandService", "C# Application Service (CQRS command side)", "Publishes the active targets and adjusts the plan")
    Component(baselineCmdService, "PatientBaselineCommandService", "C# Application Service (CQRS command side)", "Records and updates the patient baseline")
    Component(planProposalCmdService, "PlanProposalCommandService", "C# Application Service (CQRS command side)", "Accepts a plan proposal as a new plan version")
    Component(reviewItemCmdService, "ReviewItemCommandService", "C# Application Service (CQRS command side)", "Opens and resolves review items, generates the proposal, rechecks and purges")
    Component(planProposer, "PlanAdjustmentProposer", "C# Application Service (IPlanAdjustmentProposer)", "Asks the AI module for an adjustment proposal and validates it")
    Component(inputReader, "PlanAdjustmentInputReader", "C# application helper", "Gathers the plan, diagnosis, baseline, intake and monitoring evidence for a proposal")

    Component(assessmentQryService, "NutritionalAssessmentQueryService", "C# Application Service (CQRS query side)", "Reads assessments")
    Component(diagnosisQryService, "NutritionalDiagnosisQueryService", "C# Application Service (CQRS query side)", "Reads diagnoses")
    Component(planQryService, "NutritionPlanQueryService", "C# Application Service (CQRS query side)", "Reads plans and published versions")
    Component(baselineQryService, "PatientBaselineQueryService", "C# Application Service (CQRS query side)", "Reads the baseline")
    Component(reviewItemQryService, "ReviewItemQueryService", "C# Application Service (CQRS query side)", "Reads the inbox and the proposal state")
    Component(consultationQryService, "ConsultationQueryService", "C# Application Service (CQRS query side)", "Reads the consultation and its summaries")

    Component(onPublished, "OnNutritionPlanPublishedHandler", "Cortex.Mediator IEventHandler of NutritionPlanPublished", "Policy 3.5: publishes the reduced contract")
    Component(onAdjusted, "OnNutritionPlanAdjustedHandler", "Cortex.Mediator IEventHandler of NutritionPlanAdjusted", "Policy 3.6: republishes on adjustment")
    Component(onDeviation, "OnSustainedDeviationDetectedHandler", "Cortex.Mediator IEventHandler of SustainedDeviationDetected", "Policy 3.7: opens an item, never edits the plan")
    Component(onAlertEscalated, "OnAlertEscalatedToPractitionerHandler", "Cortex.Mediator IEventHandler of AlertEscalatedToPractitioner", "Opens an item for the consistency alert")
    Component(onAiConsent, "OnAiProcessingConsentChangedNutritionalCareHandler", "Cortex.Mediator IEventHandler of AiProcessingConsentChanged", "Purges the plan proposals not yet accepted")

    Component(proposalQueue, "InMemoryPlanProposalGenerationQueue", "C# in-memory queue (IPlanProposalGenerationQueue)", "Review items waiting for a generated proposal")
    Component(proposalGenHostedService, "PlanProposalGenerationHostedService", "ASP.NET Core BackgroundService", "Generates the queued plan proposals")
    Component(proposalRecoveryHostedService, "PlanProposalRecoveryHostedService", "ASP.NET Core BackgroundService", "Re-enqueues the proposals left unfinished")
    Component(recheckHostedService, "ReviewItemRecheckHostedService", "ASP.NET Core BackgroundService", "Opens the rechecks that are due")

    Component(ncFacade, "NutritionalCareContextFacade", "C# ACL - Open Host Service (INutritionalCareContextFacade)", "Publishes the active targets, baseline, consultation state and review signals")
    Component(targetPolicies, "BmrCalculator, ConfiguredActivityFactorProvider, ConfiguredCalorieFloorPolicy, DefaultTargetParametersPolicy and ConfiguredDefaultGuidelinesProvider", "C# domain services", "Calculate and validate the targets; supply the default guidelines")
    Component(dateProvider, "ClinicalTimeZoneDateProvider", "C# infrastructure service (IClinicalDateProvider)", "Clinical day of a moment")
    Component(messageLexicon, "EmbeddedPatientMessageLexicon", "C# embedded lexicon (IPatientMessageLexicon)", "Terms a message to the patient may not contain")
    Component(aiValidators, "DiagnosisSuggestion, GuidelineSuggestions and PlanAdjustmentProposal OutputValidators", "C# IAiOutputValidator", "Reject generated output that breaks the clinical rules")

    Component(consultationAggregate, "Consultation", "C# Aggregate Root", "Steps and state of one consultation")
    Component(assessmentAggregate, "NutritionalAssessment", "C# Aggregate Root", "Habits, history and the clinical measurements taken in the consultation")
    Component(diagnosisAggregate, "NutritionalDiagnosis", "C# Aggregate Root", "Clinical diagnosis issued in the consultation")
    Component(planAggregate, "NutritionPlan", "C# Aggregate Root", "Versioned targets and guidelines")
    Component(baselineAggregate, "PatientBaseline", "C# Aggregate Root", "Stable data of the patient")
    Component(reviewItemAggregate, "ReviewItem", "C# Aggregate Root", "A signal the practitioner must resolve")
    Component(ncValueObjects, "Value Objects and Errors", "C# records and enums", "Targets, guidelines, equation, DiagnosisCode, errors")

    Component(ncRepos, "Nutritional Care Repositories", "C# Repositories over EF Core 10", "Consultation, NutritionalAssessment, NutritionalDiagnosis, NutritionPlan, PatientBaseline and ReviewItem repositories")
    Component(ncEfcConfig, "Nutritional Care EntityTypeConfigurations", "EF Core 10 Fluent API", "Maps tables, versions and audit")
}

ContainerDb(db, "Healthify Database", "MySQL 8.4", "Owns the consultation, assessment, measurement, diagnosis, plan, baseline, review item and audit tables")

Container_Ext(careRelCtx, "Care Relationship", "Sibling bounded context", "Consulted through ICareRelationshipContextFacade; publishes AiProcessingConsentChanged")
Container_Ext(iamCtx, "IAM", "Sibling bounded context", "Consulted through IIamContextFacade for names, the preferred language and the roles")
Container_Ext(intakeCtx, "Intake and Body Response", "Sibling bounded context", "Subscribes to ActiveTargetsUpdated; serves the intake and trend evidence through its Open Host Service")
Container_Ext(monitoringCtx, "Monitoring and Adherence", "Sibling bounded context", "Publishes SustainedDeviationDetected and AlertEscalatedToPractitioner; subscribes to ActiveTargetsUpdated, ClinicalMeasurementTaken and ConsultationCompleted; serves the compliance through its Open Host Service")
Container_Ext(readModelsCtx, "Read Models", "Composition layer (not a bounded context)", "Composes the patient record, consultations, monitoring panel and export from the Open Host Service")

Container_Ext(aiModule, "AI module (Shared)", "Technical module", "Generation pipeline behind consent, validation and quota controls; switched off by default")
System_Ext(gemini, "Gemini API", "Google generative model", "Suggests the diagnosis, the guidelines and the plan adjustment")

Rel(practitioner, mobile, "Runs the consultation, resolves the inbox and prescribes", "Touch")
Rel(patient, mobile, "Reads the published targets", "Touch")
Rel(mobile, consultationsController, "Drives the steps of the consultation", "JSON/HTTPS, Bearer JWT")
Rel(mobile, patientConsultationsController, "Starts and reads consultations", "JSON/HTTPS, Bearer JWT")
Rel(mobile, plansController, "Publishes and adjusts the plan", "JSON/HTTPS, Bearer JWT")
Rel(mobile, planVersionsController, "Reads the published plan versions", "JSON/HTTPS, Bearer JWT")
Rel(mobile, clinicalRecordController, "Reads the clinical record", "JSON/HTTPS, Bearer JWT")
Rel(mobile, assessmentsController, "Reads an assessment", "JSON/HTTPS, Bearer JWT")
Rel(mobile, baselineController, "Records and reads the baseline", "JSON/HTTPS, Bearer JWT")
Rel(mobile, reviewItemsController, "Reads the inbox and resolves items", "JSON/HTTPS, Bearer JWT")

Rel(consultationsController, ncAssemblers, "Maps resources and commands through", "in-process")
Rel(patientConsultationsController, ncAssemblers, "Maps resources and commands through", "in-process")
Rel(plansController, ncAssemblers, "Maps resources and commands through", "in-process")
Rel(planVersionsController, ncAssemblers, "Maps aggregates to resources through", "in-process")
Rel(clinicalRecordController, ncAssemblers, "Maps aggregates to resources through", "in-process")
Rel(assessmentsController, ncAssemblers, "Maps aggregates to resources through", "in-process")
Rel(baselineController, ncAssemblers, "Maps resources and commands through", "in-process")
Rel(reviewItemsController, ncAssemblers, "Maps resources and commands through", "in-process")

Rel(consultationsController, consultationCmdService, "Sends the consultation step commands", "in-process")
Rel(consultationsController, consultationAiCmdService, "Sends SuggestConsultationDiagnosis and GuidelinesCommand", "in-process")
Rel(consultationsController, consultationQryService, "Sends consultation queries", "in-process")
Rel(patientConsultationsController, consultationCmdService, "Sends StartConsultationCommand and AbandonConsultationCommand", "in-process")
Rel(patientConsultationsController, consultationQryService, "Sends consultation queries", "in-process")
Rel(plansController, planCmdService, "Sends PublishActiveTargetsCommand and AdjustNutritionPlanCommand", "in-process")
Rel(planVersionsController, planQryService, "Sends plan version queries", "in-process")
Rel(clinicalRecordController, assessmentQryService, "Sends assessment queries", "in-process")
Rel(clinicalRecordController, diagnosisQryService, "Sends diagnosis queries", "in-process")
Rel(clinicalRecordController, planQryService, "Sends plan queries", "in-process")
Rel(assessmentsController, assessmentQryService, "Sends assessment queries", "in-process")
Rel(baselineController, baselineCmdService, "Sends baseline commands", "in-process")
Rel(baselineController, baselineQryService, "Sends baseline queries", "in-process")
Rel(baselineController, dateProvider, "Resolves the clinical day through", "in-process")
Rel(reviewItemsController, reviewItemCmdService, "Sends ResolveReviewItemCommand", "in-process")
Rel(reviewItemsController, reviewItemQryService, "Sends inbox and proposal queries", "in-process")
Rel(reviewItemsController, planProposalCmdService, "Sends AcceptPlanProposalCommand", "in-process")
Rel(consultationsController, careRelCtx, "Authorises the access to the patient", "in-process ACL call")
Rel(patientConsultationsController, careRelCtx, "Authorises the access to the patient", "in-process ACL call")
Rel(clinicalRecordController, careRelCtx, "Authorises the access to the patient", "in-process ACL call")
Rel(baselineController, careRelCtx, "Authorises the access to the patient", "in-process ACL call")

Rel(consultationCmdService, consultationAggregate, "Starts, advances, completes and abandons", "in-process")
Rel(consultationCmdService, assessmentAggregate, "Records the assessment and takes the measurement", "in-process")
Rel(consultationCmdService, diagnosisAggregate, "Issues and supersedes the diagnosis", "in-process")
Rel(consultationCmdService, planAggregate, "Proposes, prescribes and publishes the plan", "in-process")
Rel(planCmdService, planAggregate, "Publishes the targets and creates the adjusted version", "in-process")
Rel(planProposalCmdService, planAggregate, "Creates the accepted version", "in-process")
Rel(baselineCmdService, baselineAggregate, "Records and updates", "in-process")
Rel(reviewItemCmdService, reviewItemAggregate, "Opens, resolves and rechecks", "in-process")
Rel(planProposalCmdService, reviewItemAggregate, "Resolves the item as accepted", "in-process")
Rel(planAggregate, ncValueObjects, "Is built from", "in-process")
Rel(diagnosisAggregate, ncValueObjects, "Is built from", "in-process")
Rel(consultationCmdService, targetPolicies, "Calculates and validates the targets with", "in-process")
Rel(consultationCmdService, dateProvider, "Resolves the clinical day through", "in-process")
Rel(consultationAiCmdService, targetPolicies, "Takes the default guidelines from", "in-process")
Rel(consultationQryService, targetPolicies, "Takes the default guidelines from", "in-process")
Rel(planProposalCmdService, targetPolicies, "Applies the calorie floor of", "in-process")
Rel(planProposalCmdService, dateProvider, "Resolves the clinical day through", "in-process")
Rel(reviewItemCmdService, dateProvider, "Resolves the clinical day through", "in-process")
Rel(consultationAiCmdService, aiValidators, "Validates the generated suggestions with", "in-process")
Rel(planProposer, aiValidators, "Validates the generated proposal with", "in-process")
Rel(planProposer, messageLexicon, "Checks the patient message with", "in-process")

Rel(consultationCmdService, onPublished, "Publishes NutritionPlanPublished to", "Cortex.Mediator, in-process")
Rel(onPublished, planCmdService, "Sends PublishActiveTargetsCommand", "in-process, own DI scope")
Rel(planCmdService, onAdjusted, "Publishes NutritionPlanAdjusted to", "Cortex.Mediator, in-process")
Rel(planProposalCmdService, onAdjusted, "Publishes NutritionPlanAdjusted to", "Cortex.Mediator, in-process")
Rel(onAdjusted, planCmdService, "Sends PublishActiveTargetsCommand", "in-process, own DI scope")
Rel(monitoringCtx, onDeviation, "Publishes SustainedDeviationDetected", "Cortex.Mediator, in-process")
Rel(monitoringCtx, onAlertEscalated, "Publishes AlertEscalatedToPractitioner", "Cortex.Mediator, in-process")
Rel(onDeviation, reviewItemCmdService, "Sends OpenReviewItemCommand", "in-process, own DI scope")
Rel(onAlertEscalated, reviewItemCmdService, "Sends OpenReviewItemCommand", "in-process, own DI scope")
Rel(careRelCtx, onAiConsent, "Publishes AiProcessingConsentChanged", "Cortex.Mediator, in-process")
Rel(onAiConsent, reviewItemCmdService, "Sends PurgeUnacceptedPlanProposalsCommand", "in-process, own DI scope")

Rel(reviewItemCmdService, proposalQueue, "Enqueues the item to generate", "in-process")
Rel(proposalGenHostedService, proposalQueue, "Dequeues the next item from", "in-process")
Rel(proposalGenHostedService, reviewItemCmdService, "Sends GeneratePlanProposalCommand", "in-process, queue-driven")
Rel(proposalRecoveryHostedService, reviewItemCmdService, "Sends RecoverPlanProposalsCommand", "in-process, periodic")
Rel(recheckHostedService, reviewItemCmdService, "Sends OpenDueRechecksCommand", "in-process, periodic")
Rel(reviewItemCmdService, inputReader, "Gathers the evidence through", "in-process")
Rel(planProposalCmdService, inputReader, "Gathers the evidence through", "in-process")
Rel(reviewItemCmdService, planProposer, "Asks for the adjustment proposal", "in-process")
Rel(reviewItemQryService, proposalQueue, "Checks whether the proposal is pending in", "in-process")
Rel(inputReader, ncRepos, "Reads plan, diagnosis and baseline through", "in-process")

Rel(consultationCmdService, ncRepos, "Reads and writes through", "in-process")
Rel(consultationAiCmdService, ncRepos, "Reads through", "in-process")
Rel(planCmdService, ncRepos, "Reads and writes through", "in-process")
Rel(baselineCmdService, ncRepos, "Reads and writes through", "in-process")
Rel(planProposalCmdService, ncRepos, "Reads and writes through", "in-process")
Rel(reviewItemCmdService, ncRepos, "Reads and writes through", "in-process")
Rel(assessmentQryService, ncRepos, "Reads through", "in-process")
Rel(diagnosisQryService, ncRepos, "Reads through", "in-process")
Rel(planQryService, ncRepos, "Reads through", "in-process")
Rel(baselineQryService, ncRepos, "Reads through", "in-process")
Rel(reviewItemQryService, ncRepos, "Reads through", "in-process")
Rel(consultationQryService, ncRepos, "Reads through", "in-process")
Rel(ncRepos, ncEfcConfig, "Is mapped by", "EF Core model")
Rel(ncRepos, db, "Reads from and writes to", "EF Core 10 / MySQL, TCP 3306")

Rel(ncFacade, planQryService, "Resolves the active targets through", "in-process")
Rel(ncFacade, reviewItemQryService, "Resolves the review signals through", "in-process")
Rel(ncFacade, baselineQryService, "Resolves the baseline through", "in-process")
Rel(ncFacade, consultationQryService, "Resolves the consultation state through", "in-process")
Rel(ncFacade, assessmentQryService, "Resolves the measurements through", "in-process")
Rel(ncFacade, diagnosisQryService, "Resolves the diagnosis through", "in-process")
Rel(monitoringCtx, ncFacade, "Reads the active targets and the consistency escalation", "in-process ACL call")
Rel(readModelsCtx, ncFacade, "Reads targets, baseline, consultations and record", "in-process ACL call")

Rel(planCmdService, intakeCtx, "Publishes ActiveTargetsUpdated", "Cortex.Mediator, in-process")
Rel(planCmdService, monitoringCtx, "Publishes ActiveTargetsUpdated", "Cortex.Mediator, in-process")
Rel(planCmdService, careRelCtx, "Publishes ActiveTargetsUpdated", "Cortex.Mediator, in-process")
Rel(consultationCmdService, monitoringCtx, "Publishes ClinicalMeasurementTaken and ConsultationCompleted", "Cortex.Mediator, in-process")
Rel(inputReader, intakeCtx, "Reads the intake and weight trend evidence", "in-process ACL call")
Rel(inputReader, monitoringCtx, "Reads the compliance evidence", "in-process ACL call")
Rel(consultationQryService, monitoringCtx, "Reads the compliance for the summary", "in-process ACL call")
Rel(reviewItemCmdService, monitoringCtx, "Reads the compliance for the recheck", "in-process ACL call")
Rel(consultationCmdService, careRelCtx, "Confirms the care link is active", "in-process ACL call")
Rel(consultationAiCmdService, careRelCtx, "Confirms the care link is active", "in-process ACL call")
Rel(baselineCmdService, careRelCtx, "Confirms the care link is active", "in-process ACL call")
Rel(planProposalCmdService, careRelCtx, "Confirms the care link is active", "in-process ACL call")
Rel(reviewItemCmdService, careRelCtx, "Confirms the care link is active; checks the AI consent policy", "in-process ACL call")
Rel(consultationCmdService, iamCtx, "Confirms the author is a practitioner", "in-process ACL call")
Rel(consultationAiCmdService, iamCtx, "Confirms the practitioner and reads the preferred language", "in-process ACL call")
Rel(baselineCmdService, iamCtx, "Confirms the author is a practitioner", "in-process ACL call")
Rel(planProposalCmdService, iamCtx, "Confirms the author is a practitioner", "in-process ACL call")
Rel(reviewItemQryService, iamCtx, "Resolves the names of the patients", "in-process ACL call")
Rel(inputReader, iamCtx, "Reads the preferred language of patient and practitioner", "in-process ACL call")

Rel(consultationAiCmdService, aiModule, "Generates the suggestions through", "in-process, own pipeline")
Rel(planProposer, aiModule, "Generates the adjustment proposal through", "in-process, own pipeline")
Rel(aiModule, gemini, "Sends the prompt (deterministic facts only) to", "JSON/HTTPS")

@enduml
