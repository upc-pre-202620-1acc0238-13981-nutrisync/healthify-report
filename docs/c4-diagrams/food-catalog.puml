@startuml FoodCatalog_Component_Diagram
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_TOP_DOWN()
LAYOUT_WITH_LEGEND()

title Component Diagram - Bounded Context "Food Catalog" (Container: Healthify Platform API)

Person(patient, "Patient", "Searches a food while logging a meal and reads the local catalog")
Person(practitioner, "Practitioner", "Creates a local override when the reference record does not match the food actually eaten")

Container(mobile, "Mobile Application", "Flutter / MAUI", "Search box of the diary; renders the local catalog of the patient")

Container_Boundary(api, "Healthify Platform API") {

    Component(referenceFoodsController, "ReferenceFoodsController", "ASP.NET Core REST Controller", "api/v1/reference-foods. Search, read, local overrides and catalog imports")
    Component(localCatalogController, "LocalFoodCatalogController", "ASP.NET Core REST Controller", "api/v1/patients/{id}/local-food-catalog. Local catalog of a patient")
    Component(fcAssemblers, "Food Catalog Transform Assemblers", "C# static assemblers", "Maps resources, commands and responses")

    Component(foodCmdService, "ReferenceFoodCommandService", "C# Application Service (CQRS command side)", "Searches with the providers, caches, creates overrides and AI-estimated foods, resolves names and imports snapshots")
    Component(foodQryService, "ReferenceFoodQueryService", "C# Application Service (CQRS query side)", "Local-first search, lookup by id or name, local catalog and verified foods")
    Component(onTranslated, "OnReferenceFoodTranslatedHandler", "Cortex.Mediator IEventHandler of ReferenceFoodTranslated", "Policy 6.2: the only writer on import; caches the food locally")
    Component(fcFacade, "FoodCatalogContextFacade", "C# ACL - Open Host Service (IFoodCatalogContextFacade)", "Publishes food resolution, lookup and search")

    Component(importHostedService, "CatalogImportHostedService", "ASP.NET Core BackgroundService", "Imports catalog snapshots periodically")
    Component(fcSeeder, "ReferenceFoodSeeder", "C# EF Core seeder", "Seeds the baseline catalog at startup")

    Component(foodAggregate, "ReferenceFood", "C# Aggregate Root", "A food with nutrients and provenance")
    Component(fcValueObjects, "Value Objects and Errors", "C# records and enums", "LocalName, NutrientsPer100g, SourceHash, errors")
    Component(foodMatcher, "FoodNameMatcher and NutrientCoherence", "C# Domain Services", "Match names and check nutrients for coherence")
    Component(providerPort, "IExternalFoodCatalogProvider", "C# Domain Service interface (port)", "External catalog port of the domain")
    Component(usdaProvider, "UsdaFoodDataProvider", "C# ACL adapter, HttpClient", "Translates USDA records into the port")
    Component(offProvider, "OpenFoodFactsProvider", "C# ACL adapter, HttpClient", "Translates Open Food Facts records into the port")

    Component(fcRepo, "ReferenceFoodRepository", "C# Repository over EF Core 10", "Persists the reference foods")
    Component(fcEfcConfig, "ReferenceFood EntityTypeConfiguration", "EF Core 10 Fluent API", "Maps table, search index and hash")
}

ContainerDb(db, "Healthify Database", "MySQL 8.4", "Owns the reference_foods table and its audit table")

System_Ext(usda, "USDA FoodData Central", "Public nutritional database of the U.S. Department of Agriculture. Requires an API key")
System_Ext(off, "Open Food Facts", "Open collaborative database of packaged food products")
Container_Ext(intakeCtx, "Intake and Body Response", "Sibling bounded context", "Resolves the food of a diary entry, a photo analysis or a meal idea through the Open Host Service")

Rel(patient, mobile, "Searches a food and reads the local catalog", "Touch")
Rel(practitioner, mobile, "Creates a local override", "Touch")
Rel(mobile, referenceFoodsController, "Searches, reads, creates overrides and requests imports", "JSON/HTTPS, Bearer JWT")
Rel(mobile, localCatalogController, "Reads the local catalog", "JSON/HTTPS, Bearer JWT")

Rel(referenceFoodsController, fcAssemblers, "Maps resources and commands through", "in-process")
Rel(localCatalogController, fcAssemblers, "Maps aggregates to resources through", "in-process")
Rel(referenceFoodsController, foodCmdService, "Sends search, override and import commands", "in-process")
Rel(referenceFoodsController, foodQryService, "Sends reference food queries", "in-process")
Rel(localCatalogController, foodQryService, "Sends GetLocalFoodCatalogQuery", "in-process")

Rel(foodCmdService, foodAggregate, "Caches, overrides and creates", "in-process")
Rel(foodAggregate, fcValueObjects, "Is built from", "in-process")
Rel(foodCmdService, foodMatcher, "Matches names and checks coherence with", "in-process")
Rel(foodQryService, foodMatcher, "Matches names with", "in-process")
Rel(foodCmdService, providerPort, "Fetches external snapshots through", "in-process")
Rel(usdaProvider, providerPort, "Implements", "in-process")
Rel(offProvider, providerPort, "Implements", "in-process")
Rel(usdaProvider, usda, "Fetches the foods from", "JSON/HTTPS, API key")
Rel(offProvider, off, "Fetches the foods from", "JSON/HTTPS")

Rel(foodCmdService, onTranslated, "Publishes ReferenceFoodTranslated to", "Cortex.Mediator, in-process")
Rel(onTranslated, foodCmdService, "Sends CacheFoodLocallyCommand", "in-process, own DI scope")
Rel(importHostedService, foodCmdService, "Sends ImportCatalogSnapshotCommand", "in-process, periodic")
Rel(fcSeeder, foodCmdService, "Seeds the baseline catalog through", "in-process, at startup")
Rel(fcSeeder, fcRepo, "Checks the existing foods through", "in-process, at startup")

Rel(foodCmdService, fcRepo, "Reads and writes through", "in-process")
Rel(foodQryService, fcRepo, "Reads through", "in-process")
Rel(fcRepo, fcEfcConfig, "Is mapped by", "EF Core model")
Rel(fcRepo, db, "Reads from and writes to", "EF Core 10 / MySQL, TCP 3306")

Rel(fcFacade, foodQryService, "Resolves lookups through", "in-process")
Rel(fcFacade, foodCmdService, "Resolves, searches and creates foods through", "in-process")
Rel(intakeCtx, fcFacade, "Resolves foods, nutrients and names", "in-process ACL call")

@enduml
