Rel(intakeCtx, onTrendRecalculated, "Publishes WeightTrendRecalculated", "Cortex.Mediator, in-process")

Rel(onCareLinkEstablished, windowCmdService, "Sends Close and OpenEvaluationWindowCommand", "in-process, own DI scope")
Rel(onCareLinkRevoked, windowCmdService, "Sends CloseEvaluationWindowCommand", "in-process, own DI scope")
Rel(onCareLinkRevoked, followUpCmdService, "Sends CancelFollowUpsForPatientCommand", "in-process, own DI scope")
Rel(onDischarged, windowCmdService, "Sends CloseEvaluationWindowCommand", "in-process, own DI scope")
Rel(onDischarged, followUpCmdService, "Sends CancelFollowUpsForPatientCommand", "in-process, own DI scope")
