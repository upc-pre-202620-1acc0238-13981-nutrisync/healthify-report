Rel(consistencyHostedService, consistencyQryService, "Lists the alerts to escalate through", "in-process, periodic")
Rel(consistencyHostedService, consistencyCmdService, "Sends EscalateToPractitionerCommand", "in-process, periodic")
Rel(gapHostedService, windowQryService, "Lists the open windows through", "in-process, periodic")
