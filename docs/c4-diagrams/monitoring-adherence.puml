@startuml MonitoringAdherence_Component_Diagram
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_TOP_DOWN()
LAYOUT_WITH_LEGEND()

title Component Diagram - Bounded Context "Monitoring and Adherence" (Container: Healthify Platform API)

Person(practitioner, "Practitioner", "Reads the monitoring panel, issues referrals, schedules follow-ups and reads the AI summaries")
Person(patient, "Patient", "Sees the consistency alert, answers the prompt, sends the pre-visit check-in and reads the weekly summary")

Container(mobile, "Mobile Application", "Flutter / MAUI", "Monitoring panel of the practitioner and alert surface of the patient")

Container_Boundary(api, "Healthify Platform API") {

    Component(patientMonitoringController, "PatientMonitoringController", "ASP.NET Core REST Controller", "api/v1/patients. Compliance, deviations, consistency index and referrals of a patient")
    Component(referralsController, "ReferralsController", "ASP.NET Core REST Controller", "api/v1/referrals. Issue and close referrals")
    Component(followUpsController, "ScheduledFollowUpsController", "ASP.NET Core REST Controller", "api/v1/scheduled-follow-ups. Schedule, reschedule, cancel and complete")
    Component(patientFollowUpsController, "PatientScheduledFollowUpsController", "ASP.NET Core REST Controller", "api/v1/patients/{id}/scheduled-follow-ups. Next and past visits of a patient")
    Component(checkInController, "FollowUpCheckInController", "ASP.NET Core REST Controller", "api/v1/scheduled-follow-ups/{id}/check-in. Pre-visit check-in of the patient")
    Component(promptController, "ConsistencyPromptController", "ASP.NET Core REST Controller", "api/v1/patients. Patient acknowledges the consistency prompt")
    Component(aiSummariesController, "PatientAiSummariesController", "ASP.NET Core REST Controller", "api/v1/patients/{id}. Weekly summary, suggested questions and period summary")
    Component(monAssemblers, "Monitoring Transform Assemblers", "C# static assemblers", "Maps resources, commands and responses")

    Component(windowCmdService, "EvaluationWindowCommandService", "C# Application Service (CQRS command side)", "Opens and closes windows, evaluates each day and flags logging gaps")
    Component(deviationCmdService, "DeviationCommandService", "C# Application Service (CQRS command side)", "Detects deviations and flags the sustained ones")
    Component(consistencyCmdService, "ConsistencyIndexCommandService", "C# Application Service (CQRS command side)", "Maintains the index, raises alerts, prompts and escalates")
    Component(referralCmdService, "ReferralCommandService", "C# Application Service (CQRS command side)", "Issues and closes referrals")
    Component(followUpCmdService, "ScheduledFollowUpCommandService", "C# Application Service (CQRS command side)", "Schedules, reschedules, cancels, completes and misses follow-ups")
    Component(checkInCmdService, "PreVisitCheckInCommandService", "C# Application Service (CQRS command side)", "Submits and edits the check-in until the visit starts")
    Component(weeklySummaryCmdService, "WeeklySummaryCommandService", "C# Application Service (CQRS command side)", "Generates the weekly summary from deterministic facts and purges the expired ones")
    Component(questionsCmdService, "SuggestedQuestionsCommandService", "C# Application Service (CQRS command side)", "Suggests questions for the next consultation")
    Component(summaryCmdService, "MonitoringSummaryCommandService", "C# Application Service (CQRS command side)", "Summarises a period for the practitioner")
    Component(aiContentCmdService, "MonitoringAiContentCommandService", "C# Application Service (CQRS command side)", "Purges the generated summaries and the cache")

    Component(windowQryService, "EvaluationWindowQueryService", "C# Application Service (CQRS query side)", "Reads windows and the daily compliance")
    Component(deviationQryService, "DeviationQueryService", "C# Application Service (CQRS query side)", "Reads deviations")
    Component(consistencyQryService, "ConsistencyIndexQueryService", "C# Application Service (CQRS query side)", "Reads the consistency index")
    Component(referralQryService, "ReferralQueryService", "C# Application Service (CQRS query side)", "Reads referrals")
    Component(followUpQryService, "ScheduledFollowUpQueryService", "C# Application Service (CQRS query side)", "Reads the agenda of a practitioner and the visits of a patient")
    Component(checkInQryService, "PreVisitCheckInQueryService", "C# Application Service (CQRS query side)", "Reads the check-in and whether it is locked")
    Component(weeklySummaryQryService, "WeeklySummaryQueryService", "C# Application Service (CQRS query side)", "Reads the weekly summaries")

    Component(onCareLinkEstablished, "OnCareLinkEstablishedHandler", "Cortex.Mediator IEventHandler of CareLinkEstablished", "Closes the previous window and opens a new one")
    Component(onCareLinkRevoked, "OnCareLinkRevokedHandler", "Cortex.Mediator IEventHandler of CareLinkRevoked", "Closes the window and cancels the follow-ups")
    Component(onDischarged, "OnTreatmentDischargedHandler", "Cortex.Mediator IEventHandler of TreatmentDischarged", "Closes the window and cancels future follow-ups of the patient")
    Component(onTargetsUpdated, "OnActiveTargetsUpdatedMonitoringHandler", "Cortex.Mediator IEventHandler of ActiveTargetsUpdated", "Snapshots the new targets into the window")
    Component(onMeasurement, "OnClinicalMeasurementTakenHandler", "Cortex.Mediator IEventHandler of ClinicalMeasurementTaken", "Appends the anthropometry point")
    Component(onMealHandlers, "OnMealLoggedHandler, OnEstimateConfirmedByPatientHandler, OnMealGroupLoggedHandler, OnOffPlanEntryLoggedHandler", "Cortex.Mediator IEventHandlers", "Evaluate the day of the entry (once for a group)")
    Component(onEntrySync, "OnEntrySynchronizedHandler", "Cortex.Mediator IEventHandler of EntrySynchronized", "Re-evaluates the window after a late entry")
    Component(onBatchSync, "OnDiaryBatchSynchronizedHandler", "Cortex.Mediator IEventHandler of DiaryBatchSynchronized", "Marks the unlogged days and re-evaluates the window once")
    Component(onDayEvaluated, "OnDayEvaluatedHandler", "Cortex.Mediator IEventHandler of DayEvaluated", "Detects the deviation of the day")
    Component(onDeviationDetected, "OnDeviationDetectedHandler", "Cortex.Mediator IEventHandler of DeviationDetected", "Flags the sustained deviation")
    Component(onTrendRecalculated, "OnWeightTrendRecalculatedHandler", "Cortex.Mediator IEventHandler of WeightTrendRecalculated", "Recomputes the consistency index")
    Component(onAlertRaised, "OnConsistencyAlertRaisedHandler", "Cortex.Mediator IEventHandler of ConsistencyAlertRaised", "Prompts the patient before anything is escalated")
    Component(onGapDetected, "OnLoggingGapDetectedHandler", "Cortex.Mediator IEventHandler of LoggingGapDetected", "Reminds the patient")
    Component(onConsultationCompleted, "OnConsultationCompletedHandler", "Cortex.Mediator IEventHandler of ConsultationCompleted", "Marks the follow-up as completed")
    Component(onAiConsent, "OnAiProcessingConsentChangedMonitoringHandler", "Cortex.Mediator IEventHandler of AiProcessingConsentChanged", "Purges summaries and questions when consent is withdrawn")
    Component(onAiPrefs, "OnAiPreferencesChangedMonitoringHandler", "Cortex.Mediator IEventHandler of AiPreferencesChanged", "Purges the generated content when its AI switch goes off")

    Component(consistencyHostedService, "ConsistencyEscalationHostedService", "ASP.NET Core BackgroundService", "Escalates alerts already shown to the patient")
    Component(gapHostedService, "LoggingGapDetectionHostedService", "ASP.NET Core BackgroundService", "Flags windows with days without logging")
    Component(followUpHostedService, "MissedFollowUpHostedService", "ASP.NET Core BackgroundService", "Marks overdue follow-ups as missed")
    Component(dayRepairHostedService, "ClinicalDayRepairHostedService", "ASP.NET Core BackgroundService", "Re-evaluates the logged days of the open windows")
    Component(weeklySummaryHostedService, "WeeklySummaryHostedService", "ASP.NET Core BackgroundService", "Generates each weekly summary and purges the expired ones")

    Component(monFacade, "MonitoringContextFacade", "C# ACL - Open Host Service (IMonitoringContextFacade)", "Publishes the compliance series, consistency state, anthropometry, referrals and follow-ups")
    Component(factsReader, "MonitoringFactsReader", "C# application helper", "Deterministic facts of a period: windows plus intake summaries")
    Component(aiValidators, "WeeklySummary, SuggestedQuestions and MonitoringSummary OutputValidators", "C# IAiOutputValidator", "Reject generated text that invents numbers or uses forbidden terms")
    Component(aiCache, "InMemoryMonitoringAiCache", "C# in-memory cache", "Keeps the generated questions and summaries")
    Component(aiLexicon, "EmbeddedAiLanguageLexicon", "C# embedded lexicon", "Forbidden and sensitive terms per language")
    Component(calendar, "ClinicalTimeZoneFollowUpCalendar", "C# infrastructure service (IFollowUpCalendar)", "Clinical day of a moment")

    Component(windowAggregate, "EvaluationWindow", "C# Aggregate Root", "Frozen targets and daily compliance")
    Component(deviationAggregate, "Deviation", "C# Aggregate Root", "Distance from targets over a period")
    Component(consistencyAggregate, "ConsistencyIndex", "C# Aggregate Root", "Logging consistency and its alerts")
    Component(referralAggregate, "Referral", "C# Aggregate Root", "Referral issued by the practitioner")
    Component(followUpAggregate, "ScheduledFollowUp", "C# Aggregate Root", "Follow-up appointment")
    Component(checkInAggregate, "PreVisitCheckIn", "C# Aggregate Root", "Feeling, difficulties and questions sent before a visit")
    Component(weeklySummaryAggregate, "WeeklySummary", "C# Aggregate Root", "Weekly summary of a patient, purged after 180 days")
    Component(monValueObjects, "Value Objects and Errors", "C# records and enums", "TargetsSnapshot, DailyCompliance, states, errors")

    Component(monRepos, "Monitoring Repositories", "C# Repositories over EF Core 10", "EvaluationWindow, Deviation, ConsistencyIndex, Referral, ScheduledFollowUp, PreVisitCheckIn and WeeklySummary repositories")
    Component(monEfcConfig, "Monitoring EntityTypeConfigurations", "EF Core 10 Fluent API", "Maps tables, series and audit")
}

ContainerDb(db, "Healthify Database", "MySQL 8.4", "Owns the evaluation window, deviation, consistency index, referral, follow-up, check-in and weekly summary tables")

Container_Ext(careRelCtx, "Care Relationship", "Sibling bounded context", "Publishes CareLinkEstablished, CareLinkRevoked, TreatmentDischarged, AiProcessingConsentChanged and AiPreferencesChanged; answers the authorisation query")
Container_Ext(intakeCtx, "Intake and Body Response", "Sibling bounded context", "Publishes the diary and weight events; serves the daily summaries through its Open Host Service")
Container_Ext(nutritionalCareCtx, "Nutritional Care", "Sibling bounded context", "Publishes ActiveTargetsUpdated, ClinicalMeasurementTaken and ConsultationCompleted; receives SustainedDeviationDetected and AlertEscalatedToPractitioner; reads the Open Host Service")
Container_Ext(iamCtx, "IAM", "Sibling bounded context", "Consulted through IIamContextFacade for names and the preferred language")
Container_Ext(readModelsCtx, "Read Models", "Composition layer (not a bounded context)", "Composes the monitoring panel, roster, record and export from this and the sibling facades")

Container_Ext(aiModule, "AI module (Shared)", "Technical module", "Generation pipeline behind consent, validation and quota controls; switched off by default")
System_Ext(gemini, "Gemini API", "Google generative model", "Writes the summaries and the suggested questions")

Rel(practitioner, mobile, "Reads the panel, issues referrals and schedules follow-ups", "Touch")
Rel(patient, mobile, "Answers the prompt and sends the check-in", "Touch")
Rel(mobile, patientMonitoringController, "Reads compliance, deviations and the index", "JSON/HTTPS, Bearer JWT")
Rel(mobile, referralsController, "Issues and closes referrals", "JSON/HTTPS, Bearer JWT")
Rel(mobile, followUpsController, "Schedules and manages follow-ups", "JSON/HTTPS, Bearer JWT")
Rel(mobile, patientFollowUpsController, "Reads the visits of a patient", "JSON/HTTPS, Bearer JWT")
Rel(mobile, checkInController, "Submits and reads the check-in", "JSON/HTTPS, Bearer JWT")
Rel(mobile, promptController, "Acknowledges the prompt", "JSON/HTTPS, Bearer JWT")
Rel(mobile, aiSummariesController, "Reads summaries and suggested questions", "JSON/HTTPS, Bearer JWT")

Rel(patientMonitoringController, monAssemblers, "Maps aggregates to resources through", "in-process")
Rel(referralsController, monAssemblers, "Maps resources and commands through", "in-process")
Rel(followUpsController, monAssemblers, "Maps resources and commands through", "in-process")
Rel(patientFollowUpsController, monAssemblers, "Maps aggregates to resources through", "in-process")
Rel(checkInController, monAssemblers, "Maps resources and commands through", "in-process")
Rel(aiSummariesController, monAssemblers, "Maps views to resources through", "in-process")

Rel(patientMonitoringController, windowQryService, "Sends window queries", "in-process")
Rel(patientMonitoringController, deviationQryService, "Sends deviation queries", "in-process")
Rel(patientMonitoringController, consistencyQryService, "Sends index queries", "in-process")
Rel(patientMonitoringController, referralQryService, "Sends referral queries", "in-process")
Rel(referralsController, referralCmdService, "Sends referral commands", "in-process")
Rel(followUpsController, followUpCmdService, "Sends follow-up commands", "in-process")
Rel(followUpsController, followUpQryService, "Sends agenda queries", "in-process")
Rel(patientFollowUpsController, followUpQryService, "Sends follow-up queries", "in-process")
Rel(checkInController, checkInCmdService, "Sends check-in commands", "in-process")
Rel(checkInController, checkInQryService, "Sends check-in queries", "in-process")
Rel(checkInController, followUpQryService, "Reads the follow-up through", "in-process")
Rel(promptController, consistencyCmdService, "Sends AcknowledgeConsistencyPromptCommand", "in-process")
Rel(aiSummariesController, weeklySummaryQryService, "Sends weekly summary queries", "in-process")
Rel(aiSummariesController, questionsCmdService, "Sends SuggestQuestionsCommand", "in-process")
Rel(aiSummariesController, summaryCmdService, "Sends SummarizeMonitoringCommand", "in-process")
Rel(patientMonitoringController, careRelCtx, "Authorises the access to the patient", "in-process ACL call")
Rel(patientFollowUpsController, careRelCtx, "Authorises the access to the patient", "in-process ACL call")
Rel(checkInController, careRelCtx, "Authorises the access to the patient", "in-process ACL call")

Rel(windowCmdService, windowAggregate, "Opens, evaluates and closes", "in-process")
Rel(deviationCmdService, deviationAggregate, "Detects and flags", "in-process")
Rel(consistencyCmdService, consistencyAggregate, "Recomputes, prompts and escalates", "in-process")
Rel(referralCmdService, referralAggregate, "Issues and closes", "in-process")
Rel(followUpCmdService, followUpAggregate, "Schedules, completes and misses", "in-process")
Rel(checkInCmdService, checkInAggregate, "Submits and edits", "in-process")
Rel(weeklySummaryCmdService, weeklySummaryAggregate, "Generates and purges", "in-process")
Rel(windowAggregate, monValueObjects, "Is built from", "in-process")
Rel(consistencyAggregate, monValueObjects, "Is built from", "in-process")

Rel(careRelCtx, onCareLinkEstablished, "Publishes CareLinkEstablished", "Cortex.Mediator, in-process")
Rel(careRelCtx, onCareLinkRevoked, "Publishes CareLinkRevoked", "Cortex.Mediator, in-process")
Rel(careRelCtx, onDischarged, "Publishes TreatmentDischarged", "Cortex.Mediator, in-process")
Rel(careRelCtx, onAiConsent, "Publishes AiProcessingConsentChanged", "Cortex.Mediator, in-process")
Rel(careRelCtx, onAiPrefs, "Publishes AiPreferencesChanged", "Cortex.Mediator, in-process")
Rel(nutritionalCareCtx, onTargetsUpdated, "Publishes ActiveTargetsUpdated", "Cortex.Mediator, in-process")
Rel(nutritionalCareCtx, onMeasurement, "Publishes ClinicalMeasurementTaken", "Cortex.Mediator, in-process")
Rel(nutritionalCareCtx, onConsultationCompleted, "Publishes ConsultationCompleted", "Cortex.Mediator, in-process")
Rel(intakeCtx, onMealHandlers, "Publishes MealLogged, MealGroupLogged, EstimateConfirmedByPatient and OffPlanEntryLogged", "Cortex.Mediator, in-process")
