@startuml Healthify - Care Relationship Database Diagram

skinparam linetype ortho
hide circle
hide methods

!define TABLE(name,desc) entity name as "desc" << (T, #AADDFF) >>
!define EXT(name,desc) entity name as "desc" << (E, #DDDDDD) >>
!define PK(x) <u>x</u>
!define FK(x) <i>x</i>

TABLE(invitations, "invitations") {
  PK(id) : INT AUTO_INCREMENT
  --
  FK(issued_by) : INT NOT NULL
  token : VARCHAR(64) NOT NULL
  expires_at : DATETIME NOT NULL
  redeemed_at : DATETIME
  expired_at : DATETIME
  created_at : DATETIME
  updated_at : DATETIME
}

TABLE(care_links, "care_links") {
  PK(id) : INT AUTO_INCREMENT
  --
  FK(patient_id) : INT NOT NULL
  FK(practitioner_id) : INT NOT NULL
  established_at : DATETIME NOT NULL
  revoked_at : DATETIME
  discharged_at : DATETIME
  discharge_reason : VARCHAR(500)
  pending_targets_version : INT
  last_acknowledged_version : INT
  consent_granted : TINYINT(1) NOT NULL
  consent_scope : VARCHAR(200)
  consent_granted_at : DATETIME
  consent_withdrawn_at : DATETIME
  consent_ai_decided_at : DATETIME
  consent_ai_processing : TINYINT(1) NOT NULL
  last_acknowledged_at : DATETIME
  revocation_reason : VARCHAR(30)
  created_at : DATETIME
  updated_at : DATETIME
}

TABLE(ai_preferences, "ai_preferences") {
  PK(patient_id) : INT NOT NULL
  --
  meal_ideas_enabled : TINYINT(1) NOT NULL
  meal_photo_recognition_enabled : TINYINT(1) NOT NULL
  suggested_questions_enabled : TINYINT(1) NOT NULL
  weekly_summary_enabled : TINYINT(1) NOT NULL
  created_at : DATETIME
  updated_at : DATETIME
}

EXT(users, "users  (IAM)") {
  PK(id) : INT
  --
  role : VARCHAR(20)
}

invitations ||..o| care_links : "redemption establishes"

users ||..o{ invitations : "issued_by"
users ||..o{ care_links : "patient_id / practitioner_id"

users ||..o| ai_preferences : "patient_id"

@enduml
