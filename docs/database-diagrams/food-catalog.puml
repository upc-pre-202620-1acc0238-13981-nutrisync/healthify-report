@startuml Healthify - Food Catalog Database Diagram

skinparam linetype ortho
hide circle
hide methods

!define TABLE(name,desc) entity name as "desc" << (T, #AADDFF) >>
!define EXT(name,desc) entity name as "desc" << (E, #DDDDDD) >>
!define PK(x) <u>x</u>
!define FK(x) <i>x</i>

TABLE(reference_foods, "reference_foods") {
  PK(id) : INT AUTO_INCREMENT
  --
  local_name : VARCHAR(200) NOT NULL
  energy_kcal_per_100g : DECIMAL(10,2) NOT NULL
  protein_g_per_100g : DECIMAL(10,2) NOT NULL
  carb_g_per_100g : DECIMAL(10,2) NOT NULL
  fat_g_per_100g : DECIMAL(10,2) NOT NULL
  source_hash : VARCHAR(64) NOT NULL
  is_local_override : TINYINT(1) NOT NULL
  FK(ai_generation_id) : BIGINT
  is_verified : TINYINT(1) NOT NULL
  source : VARCHAR(20) NOT NULL
  FK(verified_by) : INT
  created_at : DATETIME
  updated_at : DATETIME
  --
  INDEX ix_reference_foods_local_name (local_name)
  INDEX ix_reference_foods_source (source)
  UNIQUE ix_reference_foods_source_hash (source_hash)
}

EXT(diary_entries, "diary_entries  (Intake and Body Response)") {
  PK(id) : INT
  --
  FK(proposed_reference_food_id) : INT
  FK(confirmed_reference_food_id) : INT
}

EXT(users, "users  (IAM)") {
  PK(id) : INT
  --
  role : VARCHAR(20)
}

EXT(meal_photo_analyses, "meal_photo_analyses  (Intake and Body Response)") {
  PK(id) : CHAR(36)
  --
  FK(reference_food_id) : INT
}

EXT(ai_generations, "ai_generations  (Shared)") {
  PK(id) : BIGINT
}

reference_foods ||..o{ diary_entries : "resolved via ACL"
reference_foods ||..o{ meal_photo_analyses : "resolved via ACL"

users ||..o{ reference_foods : "verified_by"

ai_generations ||..o{ reference_foods : "ai_generation_id"

@enduml
