@startuml Healthify - IAM Database Diagram

skinparam linetype ortho
hide circle
hide methods

!define TABLE(name,desc) entity name as "desc" << (T, #AADDFF) >>
!define PK(x) <u>x</u>
!define FK(x) <i>x</i>

TABLE(users, "users") {
  PK(id) : INT AUTO_INCREMENT
  --
  email : VARCHAR(255) NOT NULL
  password_hash : VARCHAR(255) NOT NULL
  role : VARCHAR(20) NOT NULL
  failed_sign_in_attempts : INT NOT NULL
  locked_out_at : DATETIME
  family_names : VARCHAR(80) NOT NULL
  given_names : VARCHAR(80) NOT NULL
  preferred_language : VARCHAR(5) NOT NULL
  created_at : DATETIME
  updated_at : DATETIME
}

TABLE(user_sessions, "user_sessions") {
  PK(id) : INT AUTO_INCREMENT
  --
  FK(user_id) : INT NOT NULL
  role_claim : VARCHAR(20) NOT NULL
  navigation_shell : VARCHAR(30)
  started_at : DATETIME NOT NULL
  terminated_at : DATETIME
  previous_refresh_token_hash : CHAR(64)
  refresh_token_expires_at : DATETIME
  refresh_token_hash : CHAR(64)
  refresh_token_rotated_at : DATETIME
  created_at : DATETIME
  updated_at : DATETIME
}

users ||..o{ user_sessions : "opens"

@enduml
