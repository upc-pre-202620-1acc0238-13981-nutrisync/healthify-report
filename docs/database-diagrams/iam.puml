@startuml Healthify - IAM Database Diagram

skinparam linetype ortho
hide circle
hide methods

!define TABLE(name,desc) entity name as "desc" << (T, #AADDFF) >>
!define PK(x) <u>x</u>
!define FK(x) <i>x</i>

TABLE(users, "users") {
  PK(id) : INT AUTO_INCREMENT
  --
  email : VARCHAR(255) NOT NULL
  password_hash : VARCHAR(255) NOT NULL
  role : VARCHAR(20) NOT NULL
  failed_sign_in_attempts : INT NOT NULL
  locked_out_at : DATETIME
  family_names : VARCHAR(80) NOT NULL
  given_names : VARCHAR(80) NOT NULL
  preferred_language : VARCHAR(5) NOT NULL
  created_at : DATETIME
  updated_at : DATETIME
  --
  UNIQUE ix_users_email (email)
}

TABLE(user_sessions, "user_sessions") {
  PK(id) : INT AUTO_INCREMENT
  --
  FK(user_id) : INT NOT NULL
  role_claim : VARCHAR(20) NOT NULL
  navigation_shell : VARCHAR(30)
  started_at : DATETIME NOT NULL
  terminated_at : DATETIME
  previous_refresh_token_hash : CHAR(64)
  refresh_token_expires_at : DATETIME
  refresh_token_hash : CHAR(64)
  refresh_token_rotated_at : DATETIME
  created_at : DATETIME
  updated_at : DATETIME
  --
  INDEX ix_user_sessions_previous_refresh_token_hash (previous_refresh_token_hash)
  UNIQUE ix_user_sessions_refresh_token_hash (refresh_token_hash)
  INDEX ix_user_sessions_user_id (user_id)
}

TABLE(password_reset_codes, "password_reset_codes") {
  PK(id) : INT AUTO_INCREMENT
  --
  FK(user_id) : INT NOT NULL
  code_hash : CHAR(64) NOT NULL
  issued_at : DATETIME NOT NULL
  expires_at : DATETIME NOT NULL
  failed_attempts : INT NOT NULL
  verified_at : DATETIME
  reset_token_hash : CHAR(64)
  reset_token_expires_at : DATETIME
  used_at : DATETIME
  created_at : DATETIME
  updated_at : DATETIME
  --
  UNIQUE ix_password_reset_codes_reset_token_hash (reset_token_hash)
  INDEX ix_password_reset_codes_user_id (user_id)
}

users ||..o{ user_sessions : "user_id"
users ||..o{ password_reset_codes : "user_id"

@enduml
